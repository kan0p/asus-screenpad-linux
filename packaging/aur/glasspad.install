post_install() {
    echo "==> Reinicia el equipo para activar GlassPad (el panel se enciende antes del compositor)."
}

post_upgrade() {
    echo "==> Reinicia la sesión de GlassPad: systemctl --user restart glasspadd glasspad-launcher"
}

pre_remove() {
    systemctl stop screenpad.service glasspad-numpad.socket glasspad-numpad.service \
        > /dev/null 2>&1 || true
}
