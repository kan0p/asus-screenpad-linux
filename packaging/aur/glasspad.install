post_install() {
    cat <<'MSG'
==> Para activar GlassPad:
    sudo usermod -aG glasspad $USER
    sudo systemctl enable screenpad.service glasspad-numpad.socket
    systemctl --user enable glasspadd.service glasspad-launcher.service
==> Reinicia el equipo: el panel se enciende antes del compositor y el grupo
    glasspad tiene efecto en la nueva sesión.
MSG
}

post_upgrade() {
    echo "==> Reinicia la sesión de GlassPad: systemctl --user restart glasspadd glasspad-launcher"
}

pre_remove() {
    systemctl disable --now screenpad.service glasspad-numpad.socket glasspad-numpad.service \
        > /dev/null 2>&1 || true
}
