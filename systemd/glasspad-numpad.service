[Unit]
Description=GlassPad: teclado numérico virtual de Number Key
Requires=glasspad-numpad.socket
After=glasspad-numpad.socket systemd-modules-load.service

[Service]
ExecStart=/usr/local/bin/glasspad-numpad
Restart=on-failure
RestartSec=2
# solo necesita /dev/uinput, leer los LED de Bloq Num en /sys y el socket
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/uinput rw
DeviceAllow=char-input r
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
