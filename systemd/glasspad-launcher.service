[Unit]
Description=GlassPad Launcher
PartOf=graphical-session.target
After=graphical-session.target glasspadd.service
# se reinicia cada vez que la salida del pad desaparece
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/glasspad-launcher
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
