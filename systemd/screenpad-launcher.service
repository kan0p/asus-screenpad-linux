[Unit]
Description=Launcher del ScreenPad
PartOf=graphical-session.target
After=graphical-session.target screenpadd.service
# el compositor lo desconecta cada vez que la salida del pad desaparece
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/screenpad-launcher
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
