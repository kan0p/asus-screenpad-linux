# Acceso de la sesión activa (uaccess) solo a lo que usa GlassPad:
# las teclas especiales de ASUS (Fn+F6) y el touchpad del ScreenPad.
# El teclado principal queda fuera.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Asus WMI hotkeys", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="GDX1515:00 27C6:01F4 Touchpad", TAG+="uaccess"
