def leer_config():
    conf = {"cycle": list(MODOS),
            "keys_device": "Asus WMI hotkeys",
            "pad_device": "GDX1515:00 27C6:01F4 Touchpad",
            "startup_mode": "last",
            "off_blocks_pad": True,
            "isolate_pointer": True,
            "idle_dim": True,
            "idle_dim_minutes": 2,
            "fullscreen_dim": True,
            "dim_level": 5,
            "battery_mode": "",
            "clipboard_history": True,
            "clipboard_popup_monitor": True,
            "clipboard_popup_dark": True,
            "clipboard_popup_off": True}
    try:
        with open(CONFIG, "rb") as f:
            conf.update(tomllib.load(f))
    except FileNotFoundError:
        pass
    except (tomllib.TOMLDecodeError, OSError) as e:
        log(f"config ignorada ({CONFIG}): {e}")
    ciclo = [m for m in conf["cycle"] if m in MODOS]
    if not ciclo:
        log("cycle vacío o inválido, se usa el ciclo completo")
        ciclo = list(MODOS)
    conf["cycle"] = ciclo
    if conf["startup_mode"] not in (*MODOS, "last"):
        log(f"startup_mode inválido: {conf['startup_mode']}, se usa el último modo")
        conf["startup_mode"] = "last"
    return conf


def leer_estado():
    try:
        with open(ESTADO) as f:
            e = json.load(f)
    except (OSError, ValueError):
        e = {}
    modo = e.get("mode") if e.get("mode") in MODOS else "monitor"
    brillo = e.get("brightness")
    brillo = brillo if isinstance(brillo, int) and 1 <= brillo <= 255 else 255
    pos = e.get("monitor_position")
    pos = tuple(pos) if isinstance(pos, list) and len(pos) == 2 else None
    return modo, brillo, pos


def leer_salidas(kdl):
    """Salidas activas de 'cosmic-randr list --kdl': nombre -> (x, y, ancho, alto, fabricante)."""
    salidas = {}
    for bloque in re.split(r'^output ', kdl, flags=re.M)[1:]:
        nombre = re.match(r'"([^"]+)" enabled=#(\w+)', bloque)
        pos = re.search(r'^\s*position (-?\d+) (-?\d+)', bloque, re.M)
        modo = re.search(r'^\s*mode (\d+) (\d+) \d+ current=#true', bloque, re.M)
        if not (nombre and pos and modo) or nombre.group(2) != "true":
            continue
        escala = re.search(r'^\s*scale ([\d.]+)', bloque, re.M)
        escala = float(escala.group(1)) if escala else 1.0
        giro = re.search(r'^\s*transform "([^"]+)"', bloque, re.M)
        ancho, alto = int(modo.group(1)), int(modo.group(2))
        if giro and giro.group(1) in GIRADAS:
            ancho, alto = alto, ancho
        fab = re.search(r'make="([^"]*)"', bloque)
        salidas[nombre.group(1)] = (int(pos.group(1)), int(pos.group(2)),
                                    round(ancho / escala), round(alto / escala),
                                    fab.group(1) if fab else "")
    return salidas


def buscar_dispositivo(nombre):
    for ruta in evdev.list_devices():
        try:
            d = evdev.InputDevice(ruta)
        except OSError:
            continue
        if d.name == nombre:
            return d
        d.close()
    return None


class Portapapeles:
    """Cliente Wayland propio para ext_data_control_v1: lee cada texto o imagen copiados y
    pone contenido en el portapapeles. Los descriptores viajan con SCM_RIGHTS."""

    EVENTOS = {
        "wl_display": [("error", "ous"), ("delete_id", "u")],
        "wl_registry": [("global", "usu"), ("global_remove", "u")],
        "wl_seat": [("capabilities", "u"), ("name", "s")],
        "ext_data_control_device_v1": [("data_offer", "n"), ("selection", "o"),
                                       ("finished", ""), ("primary_selection", "o")],
        "ext_data_control_offer_v1": [("offer", "s")],
        "ext_data_control_source_v1": [("send", "sh"), ("cancelled", "")],
    }
    NUEVOS = {("ext_data_control_device_v1", "data_offer"): "ext_data_control_offer_v1"}
    TEXTO = ("text/plain;charset=utf-8", "UTF8_STRING", "text/plain", "STRING", "TEXT")
    SECRETO = "x-kde-passwordManagerHint"      # lo marcan los gestores de contraseñas
    IMAGEN = ("image/png", "image/jpeg", "image/webp", "image/gif", "image/bmp")
    MAX_TEXTO = 1 << 20
    MAX_IMAGEN = 10 << 20

    def __init__(self, al_copiar, al_vaciar):
        self.al_copiar = al_copiar      # (tipo "texto"|"imagen", bytes, mime)
        self.al_vaciar = al_vaciar
        self.objetos = {1: "wl_display"}
        self.siguiente = 2
        self.globales = {}
        self.ofertas = {}           # id -> set de tipos MIME
        self.actual = None          # oferta de la selección vigente
        self.fuentes = {}           # id de nuestra fuente -> bytes que entrega
        self.dispositivo = None
        self.buf = b""
        self.fds = []
        self.sock = None
        ruta = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
        if not ruta.startswith("/"):
            ruta = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), ruta)
        try:
            self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            self.sock.connect(ruta)
        except OSError as e:
            log(f"portapapeles: sin conexión Wayland: {e}")
            self.sock = None
            return
        self.sock.setblocking(False)
        self.fuente = GLib.io_add_watch(self.sock.fileno(), GLib.PRIORITY_DEFAULT,
                                        GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self._leer)
        self.registro = self._nuevo("wl_registry")
        self._enviar(1, 1, self._u(self.registro))

    @staticmethod
    def _u(v):
        return struct.pack("=I", v & 0xFFFFFFFF)

    @staticmethod
    def _texto(t):
        b = t.encode() + b"\0"
        return Portapapeles._u(len(b)) + b + b"\0" * (-len(b) % 4)

    def _nuevo(self, interfaz):
        i = self.siguiente
        self.siguiente += 1
        self.objetos[i] = interfaz
        return i

    def _enviar(self, objeto, opcode, *partes, fd=None):
        if not self.sock:
            return
        datos = b"".join(partes)
        mensaje = self._u(objeto) + self._u(((8 + len(datos)) << 16) | opcode) + datos
        anexos = [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array("i", [fd]))] if fd else []
        try:
            self.sock.sendmsg([mensaje], anexos)
        except OSError as e:
            log(f"portapapeles: {e}")

    def _leer(self, _fd, _cond):
        try:
            datos, anexos, _f, _d = self.sock.recvmsg(65536, socket.CMSG_SPACE(16 * 4))
        except BlockingIOError:
            return True
        except OSError:
            datos, anexos = b"", []
        for nivel, tipo, crudo in anexos:
            if nivel == socket.SOL_SOCKET and tipo == socket.SCM_RIGHTS:
                fds = array.array("i")
                fds.frombytes(crudo[:len(crudo) - len(crudo) % fds.itemsize])
                self.fds.extend(fds)
        if not datos:
            log("portapapeles: se cerró la conexión Wayland")
            self.sock = None
            return False
        self.buf += datos
        while len(self.buf) >= 8:
            objeto, op = struct.unpack_from("=II", self.buf)
            largo, opcode = op >> 16, op & 0xFFFF
            if len(self.buf) < largo:
                break
            cuerpo, self.buf = self.buf[8:largo], self.buf[largo:]
            self._evento(objeto, opcode, cuerpo)
        return True

    def _evento(self, objeto, opcode, cuerpo):
        interfaz = self.objetos.get(objeto)
        tabla = self.EVENTOS.get(interfaz)
        if not tabla or opcode >= len(tabla):
            return
        nombre, firma = tabla[opcode]
        args, pos = [], 0
        for t in firma:
            if t in "uon":
                args.append(struct.unpack_from("=I", cuerpo, pos)[0])
                pos += 4
            elif t == "s":
                n = struct.unpack_from("=I", cuerpo, pos)[0]
                args.append(cuerpo[pos + 4:pos + 3 + n].decode(errors="replace") if n else "")
                pos += 4 + n + (-n % 4)
            elif t == "h":
                args.append(self.fds.pop(0) if self.fds else -1)
            if t == "n":
                self.objetos[args[-1]] = self.NUEVOS[(interfaz, nombre)]
        manejador = getattr(self, f"_{interfaz}_{nombre}", None)
        if manejador:
            manejador(objeto, *args)

    def _wl_display_error(self, _o, objeto, codigo, mensaje):
        log(f"portapapeles: error Wayland en {self.objetos.get(objeto)} ({codigo}): {mensaje}")

    def _wl_registry_global(self, _o, nombre, interfaz, _version):
        if interfaz in ("wl_seat", "ext_data_control_manager_v1") and interfaz not in self.globales:
            i = self._nuevo(interfaz)
            self._enviar(self.registro, 0, self._u(nombre), self._texto(interfaz), self._u(1),
                         self._u(i))
            self.globales[interfaz] = i
            if len(self.globales) == 2:
                self.dispositivo = self._nuevo("ext_data_control_device_v1")
                self._enviar(self.globales["ext_data_control_manager_v1"], 1,
                             self._u(self.dispositivo), self._u(self.globales["wl_seat"]))

    def _ext_data_control_device_v1_data_offer(self, _d, oferta):
        self.ofertas[oferta] = set()

    def _ext_data_control_offer_v1_offer(self, oferta, mime):
        self.ofertas.setdefault(oferta, set()).add(mime)

    def _ext_data_control_device_v1_selection(self, _d, oferta):
        anterior, self.actual = self.actual, oferta or None
        if anterior and anterior != self.actual:
            self._soltar_oferta(anterior)
        if not oferta:
            self.al_vaciar()
            return
        tipos = self.ofertas.get(oferta, set())
        if self.SECRETO in tipos:
            return
        mime = next((m for m in self.IMAGEN if m in tipos), None)
        tipo, limite = "imagen", self.MAX_IMAGEN
        if mime is None:
            mime = next((m for m in self.TEXTO if m in tipos), None)
            tipo, limite = "texto", self.MAX_TEXTO
        if mime is None:
            return
        lectura, escritura = os.pipe()
        self._enviar(oferta, 0, self._texto(mime), fd=escritura)    # receive
        os.close(escritura)
        os.set_blocking(lectura, False)
        partes = []

        def leer(fd, _cond):
            try:
                trozo = os.read(fd, 65536)
            except BlockingIOError:
                return True
            except OSError:
                trozo = b""
            if trozo and sum(map(len, partes)) <= limite:
                partes.append(trozo)
                return True
            os.close(fd)
            datos = b"".join(partes)
            if tipo == "imagen" and len(datos) > limite:
                log(f"portapapeles: imagen de más de {limite >> 20} MB, no se guarda")
            elif datos.strip():
                self.al_copiar(tipo, datos, mime)
            return False
        GLib.io_add_watch(lectura, GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP, leer)

    def _ext_data_control_device_v1_primary_selection(self, _d, oferta):
        if oferta and oferta != self.actual:
            self._soltar_oferta(oferta)

    def _soltar_oferta(self, oferta):
        if oferta in self.ofertas:
            del self.ofertas[oferta]
            self._enviar(oferta, 1)                                 # destroy
            self.objetos.pop(oferta, None)

    def _ext_data_control_source_v1_send(self, fuente, _mime, fd):
        datos = self.fuentes.get(fuente, b"")

        def escribir():
            try:
                with os.fdopen(fd, "wb") as f:
                    f.write(datos)
            except OSError:
                pass
        threading.Thread(target=escribir, daemon=True).start()

    def _ext_data_control_source_v1_cancelled(self, fuente):
        self.fuentes.pop(fuente, None)
        self._enviar(fuente, 1)                                     # destroy
        self.objetos.pop(fuente, None)

    def disponible(self):
        return bool(self.sock and self.dispositivo)

    def copiar(self, datos, mimes):
        """Pone 'datos' en el portapapeles, ofrecidos con los tipos 'mimes'."""
        gestor = self.globales.get("ext_data_control_manager_v1")
        if not gestor or not self.dispositivo:
            return False
        fuente = self._nuevo("ext_data_control_source_v1")
        self._enviar(gestor, 0, self._u(fuente))                    # create_data_source
        for mime in mimes:
            self._enviar(fuente, 0, self._texto(mime))              # offer
        self.fuentes[fuente] = datos
        self._enviar(self.dispositivo, 0, self._u(fuente))          # set_selection
        return True


class Servicio:
    def __init__(self, loop):
        self.loop = loop
        self.conf = leer_config()
        self.modo, self.brillo, self.pos_monitor = leer_estado()
        self.ubicando = False
        if self.conf["startup_mode"] != "last":
            self.modo = self.conf["startup_mode"]

        # Lo que creemos que tiene el hardware. None = desconocido.
        self.hw_encendido = None
        self.hw_brillo = None
        self.ocupado = False        # hay una orden al firmware en curso
        self.fallo = None           # (deseado) con el que falló la última orden
        self.espera = 0             # timeout pendiente de reconciliar_pronto
        self.atenuado = set()       # motivos: "inactividad", "pantalla completa"
        self.fin_inactividad = 0
        self.ultima_actividad = 0
        self.observador = None      # pad sin tomar, para ver actividad en modo monitor
        self.en_bateria = None
        self.modo_antes_bateria = None
        self.historial = []         # {"id", "tipo", "texto" | "archivo" y "mime", "anclado"}
        self.n_copia = 0
        self.pp = None
        self.ultimo = None          # lo último copiado, para reponerlo si su app se cierra
        self.ultimo_replug = 0      # GLib.get_monotonic_time() del último replug

        self.teclas = None
        self.pad = None
        self.vigilancias = {}
        self.id_aviso = 0
        self.avisados = set()       # problemas ya registrados, para no repetirlos

        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.nodo = Gio.DBusNodeInfo.new_for_xml(INTERFAZ)
        self.bus.register_object(RUTA, self.nodo.interfaces[0], self._dbus_llamada,
                                 self._dbus_propiedad, None)
        Gio.bus_own_name_on_connection(self.bus, BUS, Gio.BusNameOwnerFlags.NONE, None,
                                       lambda *_: self._sin_nombre())
        self._escuchar_suspension()
        self._escuchar_bateria()

        if self.modo == "launcher" and not self._hay_launcher():
            self.modo = "monitor"
        self._abrir_teclas()
        self._consultar_hardware()
        self._reiniciar_atenuado()
        self._cargar_anclados()
        self._activar_portapapeles()
        self.monitor_config = Gio.File.new_for_path(CONFIG).monitor_file(
            Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.monitor_config.connect("changed", self._config_cambiada)

    def _config_cambiada(self, _m, _f, _otro, evento):
        if evento not in (Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED,
                          Gio.FileMonitorEvent.RENAMED, Gio.FileMonitorEvent.MOVED_IN,
                          Gio.FileMonitorEvent.DELETED):
            return
        self.conf = leer_config()
        debug("config recargada")
        self._bloquear_pad(self._deseado()[2])
        self._ubicar_salida()
        self._reiniciar_atenuado()
        self._activar_portapapeles()
        self.reconciliar()

    # ----- modos ------------------------------------------------------------

    def _hay_launcher(self):
        try:
            r = self.bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus",
                                   "org.freedesktop.DBus", "NameHasOwner",
                                   GLib.Variant("(s)", (BUS_LAUNCHER,)),
                                   GLib.VariantType("(b)"), Gio.DBusCallFlags.NONE,
                                   500, None)
            return r.unpack()[0]
        except GLib.Error:
            return False

    def _ciclo_disponible(self):
        return [m for m in self.conf["cycle"]
                if m != "launcher" or self._hay_launcher()]

    def siguiente(self):
        ciclo = self._ciclo_disponible()
        if not ciclo:
            return
        i = ciclo.index(self.modo) + 1 if self.modo in ciclo else 0
        self.poner_modo(ciclo[i % len(ciclo)])

    def poner_modo(self, modo, manual=True):
        if manual:
            self.modo_antes_bateria = None
        if modo not in MODOS:
            raise ValueError(f"modo desconocido: {modo}")
        if modo == "launcher" and not self._hay_launcher():
            raise ValueError("el launcher no está corriendo")
        if modo != self.modo:
            log(f"modo: {self.modo} -> {modo}")
            self.modo = modo
            self._guardar()
            self.bus.emit_signal(None, RUTA, BUS, "ModeChanged", GLib.Variant("(s)", (modo,)))
        self._avisar(f"ScreenPad: {NOMBRES[modo]}", ICONOS[modo])
        self.fallo = None
        self._reiniciar_atenuado()
        self.reconciliar_pronto()

    def poner_brillo(self, nivel):
        nivel = max(1, min(255, int(nivel)))
        self.brillo = nivel
        self._guardar()
        self.fallo = None
        # Sin pausa: mientras una orden corre, "ocupado" junta los cambios y al
        # terminar se aplica solo el último.
        self.reconciliar()

    def _guardar(self):
        os.makedirs(os.path.dirname(ESTADO), exist_ok=True)
        tmp = ESTADO + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"mode": self.modo, "brightness": self.brillo,
                       "monitor_position": self.pos_monitor}, f)
        os.replace(tmp, ESTADO)

    # ----- reconciliación con el hardware -----------------------------------

    def _deseado(self):
        encendido = self.modo != "off"
        brillo = 0 if self.modo == "dark" else self.brillo
        if self.atenuado and self.modo in MODOS_ATENUABLES:
            brillo = min(brillo, max(1, round(255 * self._entero("dim_level", 5) / 100)))
        return encendido, brillo, self.modo == "off" and self.conf["off_blocks_pad"]

    def _entero(self, clave, omision):
        try:
            return int(self.conf[clave])
        except (KeyError, TypeError, ValueError):
            return omision

    # ----- atenuado ----------------------------------------------------------

    def _reiniciar_atenuado(self):
        """Tras un cambio de modo o de config: sin atenuar y con la cuenta de nuevo."""
        if self.atenuado:
            self.atenuado.clear()
        self._programar_inactividad()
        self._observar(self.modo == "monitor" and bool(self.conf["idle_dim"]))

    def _programar_inactividad(self):
        if self.fin_inactividad:
            GLib.source_remove(self.fin_inactividad)
            self.fin_inactividad = 0
        if self.conf["idle_dim"] and self.modo in MODOS_ATENUABLES:
            minutos = max(1, self._entero("idle_dim_minutes", 2))
            self.fin_inactividad = GLib.timeout_add_seconds(minutos * 60, self._inactivo)

    def _inactivo(self):
        self.fin_inactividad = 0
        debug("atenuado por inactividad")
        self.atenuado.add("inactividad")
        self.reconciliar()
        return False

    def actividad(self):
        ahora = GLib.get_monotonic_time()
        if ahora - self.ultima_actividad < ACTIVIDAD_S * 1_000_000 and not self.atenuado:
            return
        self.ultima_actividad = ahora
        self._programar_inactividad()
        if self.atenuado:
            debug("actividad: fin del atenuado")
            self.atenuado.clear()
            self.reconciliar()

    def pantalla_completa(self, activa):
        if activa and self.conf["fullscreen_dim"]:
            debug("atenuado por pantalla completa")
            self.atenuado.add("pantalla completa")
        else:
            self.atenuado.discard("pantalla completa")
        self.reconciliar()

    def _observar(self, si):
        if si and self.observador is None:
            try:
                dev = buscar_dispositivo(self.conf["pad_device"])
            except PermissionError:
                dev = None
            if dev is None:
                return
            self.observador = dev

            def evento(ev):
                if ev.type == ecodes.EV_KEY and ev.code == ecodes.BTN_TOUCH and ev.value == 1:
                    self.actividad()
            self._vigilar(dev, evento)
        elif not si and self.observador is not None:
            self._cerrar(self.observador)

    def reconciliar_pronto(self):
        # El bloqueo del pad va ya; el firmware espera a que se dejen de pedir cambios.
        self._bloquear_pad(self._deseado()[2])
        if self.espera:
            GLib.source_remove(self.espera)
        self.espera = GLib.timeout_add(ESPERA_MS, self._fin_espera)

    def _fin_espera(self):
        self.espera = 0
        self._ubicar_salida()
        self.reconciliar()
        return False

    # ----- posición del pad en COSMIC ---------------------------------------

    def _ubicar_salida(self):
        """Aísla el pad del cursor en MODOS_AISLADOS y lo devuelve a su lugar en monitor."""
        if (not self.conf["isolate_pointer"] or self.ubicando or self.modo == "off"
                or not shutil.which("cosmic-randr")):
            return
        self.ubicando = True
        try:
            p = Gio.Subprocess.new(["cosmic-randr", "list", "--kdl"],
                                   Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            self.ubicando = False
            return

        def listo(p, res):
            try:
                _, salida, _ = p.communicate_utf8_finish(res)
            except GLib.Error:
                salida = ""
            self.ubicando = False
            self._mover_pad(leer_salidas(salida or ""))
        p.communicate_utf8_async(None, None, listo)

    def _mover_pad(self, salidas):
        try:
            with open(CONECTOR) as f:
                pad = f.read().strip()
        except OSError:
            pad = next((n for n, s in salidas.items() if "Toshiba" in s[4]), None)
        principal = next((n for n in salidas if n != pad), None)
        if pad not in salidas or principal is None:
            return
        x, y = salidas[pad][:2]
        px, py, pw, ph = salidas[principal][:4]
        esquina = (px + pw, py + ph)
        aislado = x == esquina[0] and y >= py + ph - 4
        if self.modo in MODOS_AISLADOS and not aislado:
            self.pos_monitor = (x, y)
            self._guardar()
            destino = esquina
        elif self.modo == "monitor" and aislado and self.pos_monitor:
            destino = self.pos_monitor
        else:
            return
        debug(f"{pad}: {x},{y} -> {destino[0]},{destino[1]}")
        try:
            Gio.Subprocess.new(["cosmic-randr", "position", pad, *map(str, destino)],
                               Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error as e:
            log(f"no se pudo mover {pad}: {e.message}")

    def reconciliar(self):
        encendido, brillo, bloquear = self._deseado()
        # El bloqueo del pad es local e inmediato.
        self._bloquear_pad(bloquear)
        if self.ocupado or self.espera or self.hw_encendido is None:
            return
        deseado = (encendido, brillo)
        if self.fallo == deseado:
            return
        if encendido and not self.hw_encendido:
            # replug: tras "off" el compositor solo relee el EDID si la salida se reconecta
            falta = self.ultimo_replug + ENTRE_REPLUG_S * 1_000_000 - GLib.get_monotonic_time()
            if falta > 0:
                debug(f"replug en {falta // 1000} ms")
                self.espera = GLib.timeout_add(falta // 1000 + 1, self._fin_espera)
                return
            self.ultimo_replug = GLib.get_monotonic_time()
            self._firmware(["replug", str(brillo)], deseado, lambda: self._hw(True, brillo))
        elif not encendido and self.hw_encendido:
            self._firmware(["off"], deseado, lambda: self._hw(False, None))
        elif encendido and self.hw_brillo != brillo:
            self._firmware(["brightness", str(brillo)], deseado, lambda: self._hw(True, brillo))

    def _hw(self, encendido, brillo):
        self.hw_encendido, self.hw_brillo = encendido, brillo

    def _firmware(self, args, deseado, al_terminar):
        self.ocupado = True
        cmd = [*SUDO, SCREENPAD, *args]
        debug("ejecuta:", " ".join(cmd))
        try:
            p = Gio.Subprocess.new(cmd, Gio.SubprocessFlags.STDOUT_PIPE
                                   | Gio.SubprocessFlags.STDERR_MERGE)
        except GLib.Error as e:
            self._fallo_firmware(args, deseado, e.message)
            return

        def listo(p, res):
            try:
                _, salida, _ = p.communicate_utf8_finish(res)
            except GLib.Error as e:
                salida = e.message
            salida = (salida or "").strip()
            if p.get_successful():
                if salida:
                    debug(salida)
                al_terminar()
                self.ocupado = False
                if args[0] == "replug":
                    # COSMIC tarda en volver a publicar la salida tras el hotplug
                    GLib.timeout_add(2000, lambda: self._ubicar_salida() and False)
                self.reconciliar()
            else:
                self._fallo_firmware(args, deseado, salida)
        p.communicate_utf8_async(None, None, listo)

    def _fallo_firmware(self, args, deseado, detalle):
        self.ocupado = False
        self.fallo = deseado
        log(f"falló 'screenpad {' '.join(args)}': {detalle}")
        self._avisar("ScreenPad: error", "dialog-error-symbolic",
                     f"screenpad {args[0]} falló", urgente=True)

    def _consultar_hardware(self):
        """Lee encendido y brillo reales; hasta entonces no se toca el firmware."""
        self.ocupado = True

        def con_brillo(salida):
            try:
                self.hw_brillo = int(salida.strip())
            except ValueError:
                self.hw_brillo = None
            if self.hw_brillo and self.modo != "dark":
                self.brillo = self.hw_brillo
            self.ocupado = False
            log(f"hardware: encendido={self.hw_encendido} brillo={self.hw_brillo}, modo {self.modo}")
            self.reconciliar()

        def con_estado(salida):
            # "screenpad: encendido: 0x100a0"; el byte bajo es 0 con el panel apagado
            for linea in salida.splitlines():
                if "encendido:" in linea:
                    try:
                        self.hw_encendido = int(linea.split()[-1], 16) & 0xff != 0
                    except ValueError:
                        pass
            if self.hw_encendido is None:
                self.hw_encendido = True
            if self.hw_encendido:
                self._leer(["brightness"], con_brillo)
            else:
                con_brillo("")

        self._leer(["status"], con_estado)

    def _leer(self, args, cb):
        try:
            p = Gio.Subprocess.new([*SUDO, SCREENPAD, *args],
                                   Gio.SubprocessFlags.STDOUT_PIPE
                                   | Gio.SubprocessFlags.STDERR_MERGE)
        except GLib.Error as e:
            log(f"no se pudo ejecutar screenpad: {e.message}")
            cb("")
            return

        def listo(p, res):
            try:
                _, salida, _ = p.communicate_utf8_finish(res)
            except GLib.Error:
                salida = ""
            if not p.get_successful():
                log(f"'screenpad {' '.join(args)}' falló: {(salida or '').strip()}")
            cb(salida or "")
        p.communicate_utf8_async(None, None, listo)

    # ----- dispositivos de entrada -------------------------------------------

    def _vigilar(self, dev, manejar):
        def leer(_fd, _cond):
            try:
                for ev in dev.read():
                    manejar(ev)
            except BlockingIOError:
                pass
            except OSError as e:
                log(f"se perdió {dev.name}: {e}")
                self._cerrar(dev)
                GLib.timeout_add_seconds(2, self._reabrir)
                return False
            return True
        self.vigilancias[dev.fd] = GLib.io_add_watch(dev.fd, GLib.PRIORITY_DEFAULT,
                                                     GLib.IO_IN | GLib.IO_ERR | GLib.IO_HUP, leer)

    def _cerrar(self, dev):
        fuente = self.vigilancias.pop(dev.fd, None)
        if fuente:
            GLib.source_remove(fuente)
        try:
            dev.close()
        except OSError:
            pass
        if dev is self.teclas:
            self.teclas = None
        if dev is self.pad:
            self.pad = None
        if dev is self.observador:
            self.observador = None

    def _reabrir(self):
        if self.teclas is None:
            self._abrir_teclas()
        self.reconciliar()
        return False

    def _abrir_teclas(self):
        try:
            self.teclas = buscar_dispositivo(self.conf["keys_device"])
        except PermissionError:
            self.teclas = None
        if self.teclas is None:
            log_una_vez(self.avisados, "teclas", f"sin acceso a '{self.conf['keys_device']}'"
                        " (¿falta la regla udev?), se reintenta cada 5 s")
            GLib.timeout_add_seconds(5, self._reabrir)
            return
        self.avisados.discard("teclas")
        log(f"escuchando Fn+F6 en {self.teclas.path}")
        self._vigilar(self.teclas, self._tecla)

    def _tecla(self, ev):
        if ev.type == ecodes.EV_KEY and ev.code in TECLAS_MODO and ev.value == 1:
            debug("Fn+F6")
            self.siguiente()

    def _bloquear_pad(self, bloquear):
        if bloquear and self.pad is None:
            try:
                pad = buscar_dispositivo(self.conf["pad_device"])
            except PermissionError:
                pad = None
            if pad is None:
                log_una_vez(self.avisados, "pad",
                            f"no se pudo abrir '{self.conf['pad_device']}' para bloquearlo")
                return
            self.avisados.discard("pad")
            try:
                pad.grab()
            except OSError as e:
                log(f"no se pudo bloquear el pad: {e}")
                pad.close()
                return
            self.pad = pad
            # Se leen y descartan los eventos para que no se acumulen.
            self._vigilar(pad, lambda _ev: None)
            debug("pad bloqueado")
        elif not bloquear and self.pad is not None:
            self._cerrar(self.pad)      # cerrar libera el grab
            debug("pad liberado")

    # ----- suspensión --------------------------------------------------------

    def _escuchar_suspension(self):
        try:
            sistema = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        except GLib.Error:
            return

        def al_dormir(_c, _s, _r, _i, _n, params):
            if not params.unpack()[0]:
                # Al despertar el firmware puede haber apagado el panel: se vuelve a leer.
                log("reanudación: se relee el hardware")
                self.hw_encendido = self.hw_brillo = None
                GLib.timeout_add_seconds(2, lambda: self._consultar_hardware() and False)
        sistema.signal_subscribe("org.freedesktop.login1", "org.freedesktop.login1.Manager",
                                 "PrepareForSleep", "/org/freedesktop/login1", None,
                                 Gio.DBusSignalFlags.NONE, al_dormir)
        self._sistema = sistema

    # ----- portapapeles -------------------------------------------------------

    def _activar_portapapeles(self):
        si = bool(self.conf["clipboard_history"])
        if si and self.pp is None:
            shutil.rmtree(IMAGENES_TEMPORALES, ignore_errors=True)
            os.makedirs(IMAGENES_TEMPORALES, mode=0o700, exist_ok=True)
            self.pp = Portapapeles(self._copiado, self._vaciado)
        elif not si and self.pp is not None:
            if self.pp.sock:
                GLib.source_remove(self.pp.fuente)
                self.pp.sock.close()
            self.pp = None
            self.ultimo = None
            for h in [h for h in self.historial if not h["anclado"]]:
                self._olvidar(h)
            self._cambio_portapapeles()

    def _cargar_anclados(self):
        try:
            with open(ANCLADOS) as f:
                guardados = json.load(f)
        except (OSError, ValueError):
            guardados = []
        for g in guardados if isinstance(guardados, list) else []:
            if isinstance(g, str):
                g = {"tipo": "texto", "texto": g}
            if not isinstance(g, dict):
                continue
            if g.get("tipo") == "imagen":
                archivo = os.path.join(IMAGENES_ANCLADAS, os.path.basename(str(g.get("archivo"))))
                if not os.path.isfile(archivo):
                    continue
                h = {"tipo": "imagen", "archivo": archivo, "mime": g.get("mime", "image/png"),
                     "huella": g.get("huella", "")}
            elif isinstance(g.get("texto"), str):
                h = {"tipo": "texto", "texto": g["texto"]}
            else:
                continue
            self.n_copia += 1
            self.historial.append({"id": self.n_copia, "anclado": True, **h})

    def _guardar_anclados(self):
        guardados = []
        for h in self.historial:
            if not h["anclado"]:
                continue
            if h["tipo"] == "imagen":
                guardados.append({"tipo": "imagen", "archivo": os.path.basename(h["archivo"]),
                                  "mime": h["mime"], "huella": h["huella"]})
            else:
                guardados.append({"tipo": "texto", "texto": h["texto"]})
        os.makedirs(os.path.dirname(ANCLADOS), exist_ok=True)
        tmp = ANCLADOS + ".tmp"
        with open(tmp, "w") as f:
            json.dump(guardados, f)
        os.replace(tmp, ANCLADOS)

    def _mover_imagen(self, h, carpeta):
        """Lleva el archivo de una imagen a otra carpeta (temporal o de anclados)."""
        destino = os.path.join(carpeta, os.path.basename(h["archivo"]))
        if destino != h["archivo"]:
            os.makedirs(carpeta, mode=0o700, exist_ok=True)
            shutil.move(h["archivo"], destino)
            h["archivo"] = destino

    def _olvidar(self, h):
        self.historial.remove(h)
        if h["tipo"] == "imagen":
            try:
                os.remove(h["archivo"])
            except OSError:
                pass

    def _copiado(self, tipo, datos, mime):
        if tipo == "imagen":
            huella = hashlib.sha1(datos).hexdigest()
            previo = next((h for h in self.historial if h.get("huella") == huella), None)
        else:
            texto = datos.decode(errors="replace")
            previo = next((h for h in self.historial if h.get("texto") == texto), None)
        if previo is None:
            self.n_copia += 1
            if tipo == "imagen":
                archivo = os.path.join(IMAGENES_TEMPORALES,
                                       f"{huella}.{EXTENSION.get(mime, 'img')}")
                with open(archivo, "wb") as f:
                    f.write(datos)
                previo = {"id": self.n_copia, "tipo": "imagen", "archivo": archivo,
                          "mime": mime, "huella": huella, "anclado": False}
            else:
                previo = {"id": self.n_copia, "tipo": "texto", "texto": texto, "anclado": False}
        elif not previo["anclado"]:
            self.historial.remove(previo)
        self.ultimo = previo
        if not previo["anclado"]:
            self.historial.insert(0, previo)
            sueltos = [h for h in self.historial if not h["anclado"]]
            for h in sueltos[MAX_HISTORIAL:]:
                self._olvidar(h)
        self._cambio_portapapeles()

    def _vaciado(self):
        """La app dueña del portapapeles se cerró: se repone lo último copiado."""
        if self.ultimo and self.ultimo in self.historial:
            debug("portapapeles vacío: se repone lo último copiado")
            GLib.timeout_add(100, lambda: self._poner_en_portapapeles(self.ultimo) and False)

    def _poner_en_portapapeles(self, h):
        if not self.pp:
            return False
        if h["tipo"] == "imagen":
            try:
                with open(h["archivo"], "rb") as f:
                    datos = f.read()
            except OSError:
                return False
            return self.pp.copiar(datos, [h["mime"]])
        return self.pp.copiar(h["texto"].encode(), Portapapeles.TEXTO)

    def _cambio_portapapeles(self):
        self.bus.emit_signal(None, RUTA, BUS, "ClipboardChanged", None)

    def _item(self, ident):
        h = next((h for h in self.historial if h["id"] == ident), None)
        if h is None:
            raise ValueError("ese elemento ya no está en el historial")
        return h

    def items_portapapeles(self):
        orden = [h for h in self.historial if h["anclado"]] + \
                [h for h in self.historial if not h["anclado"]]
        return [(h["id"], h["tipo"], h["archivo"] if h["tipo"] == "imagen" else h["texto"],
                 h["anclado"]) for h in orden]

    def pegar(self, ident, shift):
        h = self._item(ident)
        if not self._poner_en_portapapeles(h):
            raise ValueError("el portapapeles no está disponible")
        args = ["-M", "ctrl", *(["-M", "shift"] if shift else []), "-k", "v",
                *(["-m", "shift"] if shift else []), "-m", "ctrl"]

        def ctrl_v():
            try:
                Gio.Subprocess.new(["wtype", *args], Gio.SubprocessFlags.STDERR_SILENCE)
            except GLib.Error as e:
                log(f"pegar: {e.message}")
            return False
        GLib.timeout_add(120, ctrl_v)

    def anclar(self, ident, si):
        h = self._item(ident)
        h["anclado"] = bool(si)
        if h["tipo"] == "imagen":
            self._mover_imagen(h, IMAGENES_ANCLADAS if si else IMAGENES_TEMPORALES)
        self._guardar_anclados()
        self._cambio_portapapeles()

    def borrar(self, ident):
        h = self._item(ident)
        self._olvidar(h)
        if h["anclado"]:
            self._guardar_anclados()
        self._cambio_portapapeles()

    def borrar_todo(self):
        for h in [h for h in self.historial if not h["anclado"]]:
            self._olvidar(h)
        self._cambio_portapapeles()

    def mostrar_portapapeles(self):
        if self.modo == "launcher" and self._hay_launcher():
            lugar = "pad"
        elif self.conf.get(f"clipboard_popup_{self.modo}", True):
            lugar = "principal"
        else:
            log(f"portapapeles: desactivado en modo {self.modo}")
            return
        log(f"portapapeles: se muestra en {'el pad' if lugar == 'pad' else 'la pantalla principal'}")
        self.bus.emit_signal(None, RUTA, BUS, "ClipboardRequested", GLib.Variant("(s)", (lugar,)))

    # ----- batería -----------------------------------------------------------

    def _escuchar_bateria(self):
        sistema = getattr(self, "_sistema", None)
        if sistema is None:
            return
        try:
            r = sistema.call_sync("org.freedesktop.UPower", "/org/freedesktop/UPower",
                                  "org.freedesktop.DBus.Properties", "Get",
                                  GLib.Variant("(ss)", ("org.freedesktop.UPower", "OnBattery")),
                                  GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 1000, None)
            self._bateria(r.unpack()[0])
        except GLib.Error:
            return

        def cambio(_c, _s, _r, _i, _n, params):
            interfaz, cambios, _inv = params.unpack()
            if interfaz == "org.freedesktop.UPower" and "OnBattery" in cambios:
                self._bateria(cambios["OnBattery"])
        sistema.signal_subscribe("org.freedesktop.UPower", "org.freedesktop.DBus.Properties",
                                 "PropertiesChanged", "/org/freedesktop/UPower", None,
                                 Gio.DBusSignalFlags.NONE, cambio)

    def _bateria(self, en_bateria):
        if en_bateria == self.en_bateria:
            return
        self.en_bateria = en_bateria
        modo = self.conf["battery_mode"]
        try:
            if en_bateria and modo in MODOS and modo != self.modo:
                log(f"con batería: {self.modo} -> {modo}")
                antes = self.modo
                self.poner_modo(modo, manual=False)
                self.modo_antes_bateria = antes
            elif not en_bateria and self.modo_antes_bateria:
                antes, self.modo_antes_bateria = self.modo_antes_bateria, None
                log(f"con cargador: vuelve a {antes}")
                self.poner_modo(antes, manual=False)
        except ValueError as e:
            log(f"modo por batería: {e}")

    # ----- avisos ------------------------------------------------------------

    def _avisar(self, titulo, icono, cuerpo="", urgente=False):
        hints = {"transient": GLib.Variant("b", True),
                 "urgency": GLib.Variant("y", 2 if urgente else 0)}
        params = GLib.Variant("(susssasa{sv}i)", ("GlassPad", self.id_aviso, icono, titulo,
                                                  cuerpo, [], hints, 1500))

        def listo(bus, res):
            try:
                self.id_aviso = bus.call_finish(res).unpack()[0]
            except GLib.Error as e:
                debug(f"aviso no mostrado: {e.message}")
        self.bus.call("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                      "org.freedesktop.Notifications", "Notify", params,
                      GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, 1000, None, listo)

    # ----- D-Bus -------------------------------------------------------------

    def _dbus_llamada(self, _c, _s, _r, _i, metodo, params, inv):
        try:
            if metodo == "SetMode":
                self.poner_modo(params.unpack()[0])
            elif metodo == "NextMode":
                self.siguiente()
            elif metodo == "SetBrightness":
                self.poner_brillo(params.unpack()[0])
            elif metodo == "Activity":
                self.actividad()
            elif metodo == "SetFullscreen":
                self.pantalla_completa(params.unpack()[0])
            elif metodo == "ShowClipboard":
                self.mostrar_portapapeles()
            elif metodo == "ClipboardItems":
                inv.return_value(GLib.Variant("(a(ussb))", (self.items_portapapeles(),)))
                return
            elif metodo == "ClipboardPaste":
                self.pegar(*params.unpack())
            elif metodo == "ClipboardPin":
                self.anclar(*params.unpack())
            elif metodo == "ClipboardDelete":
                self.borrar(params.unpack()[0])
            elif metodo == "ClipboardClear":
                self.borrar_todo()
            inv.return_value(None)
        except ValueError as e:
            inv.return_dbus_error(f"{BUS}.Error", str(e))

    def _dbus_propiedad(self, _c, _s, _r, _i, nombre):
        if nombre == "Mode":
            return GLib.Variant("s", self.modo)
        if nombre == "Brightness":
            return GLib.Variant("u", self.brillo)
        if nombre == "Cycle":
            return GLib.Variant("as", self._ciclo_disponible())
        return None

    def _sin_nombre(self):
        log(f"{BUS} ya tiene dueño: ¿hay otro glasspadd corriendo?")
        self.loop.quit()

    def cerrar(self):
        for dev in (self.teclas, self.pad):
            if dev is not None:
                self._cerrar(dev)


def main():
    loop = GLib.MainLoop()
    servicio = Servicio(loop)
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal_add(GLib.PRIORITY_DEFAULT, sig, lambda: loop.quit() or False)
    loop.run()
    servicio.cerrar()


if __name__ == "__main__":
    main()
