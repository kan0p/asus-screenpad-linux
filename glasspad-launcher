    def _pagina_calculadora(self):
        self.expresion = ""
        self.resultado = None
        pantalla = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, css_classes=["visor"],
                           hexpand=True, valign=Gtk.Align.FILL)
        self.visor_expr = Gtk.Label(xalign=1, css_classes=["expr"], ellipsize=1,
                                    vexpand=True, valign=Gtk.Align.END)
        self.visor_res = Gtk.Label(label="0", xalign=1, css_classes=["res"], ellipsize=1)
        pantalla.append(self.visor_expr)
        pantalla.append(self.visor_res)
        insertar = self._tecla(self._insertar_resultado, "Insertar", "edit-paste-symbolic",
                               clases=("insertar",))
        insertar.set_vexpand(False)
        izq = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18, hexpand=True)
        izq.append(pantalla)
        izq.append(insertar)

        g = Gtk.Grid(column_spacing=18, row_spacing=18, column_homogeneous=True,
                     row_homogeneous=True, hexpand=True)
        sep = DECIMAL
        teclas = [  # (texto, entrada, columna, fila, ancho)
            ("C", "C", 0, 0, 1), ("⌫", "⌫", 1, 0, 1), ("%", "%", 2, 0, 1), ("÷", "/", 3, 0, 1),
            ("7", "7", 0, 1, 1), ("8", "8", 1, 1, 1), ("9", "9", 2, 1, 1), ("×", "*", 3, 1, 1),
            ("4", "4", 0, 2, 1), ("5", "5", 1, 2, 1), ("6", "6", 2, 2, 1), ("−", "-", 3, 2, 1),
            ("1", "1", 0, 3, 1), ("2", "2", 1, 3, 1), ("3", "3", 2, 3, 1), ("+", "+", 3, 3, 1),
            ("0", "0", 0, 4, 2), (sep, ".", 2, 4, 1), ("=", "=", 3, 4, 1),
        ]
        for texto, entrada, x, y, w in teclas:
            clases = (("igual",) if entrada == "=" else
                      ("operador",) if not entrada.isdigit() and entrada != "." else ())
            g.attach(self._tecla(lambda e=entrada: self._calcular(e), texto, clases=clases),
                     x, y, w, 1)

        caja = Gtk.Box(spacing=36, homogeneous=True, css_classes=["teclado", "calculadora"])
        caja.append(izq)
        caja.append(g)
        return caja

    def _calcular(self, entrada):
        if entrada == "C":
            self.expresion, self.resultado = "", None
        elif entrada == "⌫":
            self.expresion = self.expresion[:-1]
        elif entrada == "=":
            if self.resultado is not None:
                self.expresion = numero_a_texto(self.resultado, ".")
        else:
            if self.expresion == "" and entrada in "+*/%" and self.resultado is not None:
                self.expresion = numero_a_texto(self.resultado, ".")
            self.expresion += entrada
        self.resultado = evaluar(self.expresion)
        self.visor_expr.set_label(self._legible(self.expresion))
        self.visor_res.set_label(numero_a_texto(self.resultado, DECIMAL)
                                 if self.resultado is not None else
                                 ("0" if not self.expresion else "…"))

    def _legible(self, expr):
        return (expr.replace("*", " × ").replace("/", " ÷ ").replace("+", " + ")
                .replace("-", " − ").replace(".", DECIMAL))

    def _insertar_resultado(self):
        if self.resultado is not None:
            texto = numero_a_texto(self.resultado, ".")
            if "e" in texto:            # notación científica: no hay teclas para eso
                self.escribir(["--", texto.replace(".", DECIMAL)])
            else:
                self.numpad([TECLA_NUMPAD[c] for c in texto])

