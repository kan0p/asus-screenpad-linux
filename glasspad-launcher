def leer_config():
    conf = dict(CONFIG_PREDETERMINADA)
    try:
        with open(CONFIG, "rb") as f:
            conf.update(tomllib.load(f))
    except FileNotFoundError:
        pass
    except (tomllib.TOMLDecodeError, OSError) as e:
        log(f"config ignorada ({CONFIG}): {e}")
    return conf


def leer_inicio():
    """Ids del inicio en orden. Las utilidades de EN_INICIO que nunca se ofrecieron se
    agregan al final una sola vez."""
    datos = {}
    try:
        with open(INICIO) as f:
            datos = json.load(f)
    except (FileNotFoundError, ValueError, OSError):
        pass
    if not isinstance(datos, dict):
        datos = {}
    ids = [i for i in datos.get("inicio", []) if isinstance(i, str)]
    ofrecidas = set(datos.get("ofrecidas", []))
    nuevas = [u for u in EN_INICIO if u not in ofrecidas]
    if nuevas:
        ids += [u for u in nuevas if u not in ids]
        guardar_inicio(ids, ofrecidas | set(nuevas))
    return ids


def combinacion_wtype(texto):
    """'ctrl+shift+z' -> argumentos de wtype que la presionan y la sueltan."""
    partes = [p.strip() for p in str(texto).split("+") if p.strip()]
    if not partes:
        raise ValueError("combinación vacía")
    mods = []
    for p in partes[:-1]:
        if p.lower() not in MODIFICADORES:
            raise ValueError(f"modificador desconocido: {p}")
        mods.append(MODIFICADORES[p.lower()])
    args = [a for m in mods for a in ("-M", m)]
    args += ["-k", partes[-1]]
    args += [a for m in reversed(mods) for a in ("-m", m)]
    return args


OPERACIONES = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul,
               ast.Div: operator.truediv, ast.USub: operator.neg, ast.UAdd: operator.pos}


def evaluar(expr):
    """Valor de una expresión con + - * / y decimales, o None si no está completa.
    'n%' es un porcentaje: n/100."""
    expr = re.sub(r"(\d+(?:\.\d*)?|\.\d+)%", r"(\1/100)", expr).rstrip("+-*/.%")
    if not expr:
        return None
    try:
        arbol = ast.parse(expr, mode="eval").body
    except SyntaxError:
        return None

    def valor(n):
        if isinstance(n, ast.Constant) and isinstance(n.value, (int, float)):
            return n.value
        if isinstance(n, ast.BinOp) and type(n.op) in OPERACIONES:
            return OPERACIONES[type(n.op)](valor(n.left), valor(n.right))
        if isinstance(n, ast.UnaryOp) and type(n.op) in OPERACIONES:
            return OPERACIONES[type(n.op)](valor(n.operand))
        raise ValueError
    try:
        return valor(arbol)
    except (ValueError, ZeroDivisionError, OverflowError):
        return None


def numero_a_texto(x, decimal):
    texto = f"{x:.10g}" if isinstance(x, float) else str(x)
    if "e" not in texto and "." in texto:
        texto = texto.rstrip("0").rstrip(".")
    return texto.replace(".", decimal)


