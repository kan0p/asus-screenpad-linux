        pad = self._conector_pad()
        grupos = [("Pantalla principal", [(c, v) for c, v in lista if self.wl.salida(c) != pad]),
                  ("ScreenPad", [(c, v) for c, v in lista if pad and self.wl.salida(c) == pad])]
        for nombre, ventanas in grupos:
