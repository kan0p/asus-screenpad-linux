    def _deslizable(self, widget, al_cambiar, al_soltar=None):
        self._accion(widget, lambda: None)
        self.deslizables[widget.get_name()] = (widget, al_cambiar, al_soltar)

    def empezar_deslizable(self, objetivo, pos):
        """Llamado por Pad al apoyar sobre un control deslizable: lo sigue hasta soltar."""
        par = self.deslizables.get(objetivo.get_name())
        if not par:
            return False
        widget, al_cambiar, al_soltar = par

        def mover(p):
            ok, caja = widget.compute_bounds(self.ventana)
            if ok and caja.get_width() > 0:
                al_cambiar(max(0.0, min(1.0, (p[0] - caja.get_x()) / caja.get_width())))
        mover(pos)
        self.pad.arrastrar(mover, lambda _p: al_soltar and al_soltar())
        return True

