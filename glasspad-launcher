def color(texto, predeterminado="#1b2433"):
    c = Gdk.RGBA()
    if not c.parse(str(texto)):
        c.parse(predeterminado)
    return c


class Pad:
    """Lee el pad: toques, toque largo y arrastre cuando está tomado; estela y cuatro
    dedos siempre."""

    def __init__(self, launcher):
        self.launcher = launcher
        self.dev = None
        self.fuente = 0
        self.tomado = False
        self.max_x = self.max_y = 1
        self.x = self.y = 0
        self.slot = 0
        self.dedos = {}             # slot -> [x, y] en unidades del pad
        self.tocando = False
        self.t_apoyo = None         # cuándo empezó el toque actual
        self.max_dedos = 0
        self.inicio = None          # (x, y) lógicos del toque de un dedo
        self.ultimo = None
        self.movido = False
        self.objetivo = None        # widget con acción bajo el dedo
        self.largo = 0              # timeout del toque largo
        self.arrastre = None        # (mover, soltar) mientras se arrastra algo

    def abrir(self):
        if self.dev:
            return True
        try:
            dev = buscar_pad(self.launcher.conf["pad_device"])
        except PermissionError:
            dev = None
        if dev is None:
            log(f"no se pudo abrir '{self.launcher.conf['pad_device']}'")
            return False
        abs_ = dict(dev.capabilities(absinfo=True).get(ecodes.EV_ABS, []))
        self.max_x = abs_[ecodes.ABS_X].max if ecodes.ABS_X in abs_ else 3840
        self.max_y = abs_[ecodes.ABS_Y].max if ecodes.ABS_Y in abs_ else 2160
        self.dev = dev
        self.fuente = GLib.io_add_watch(dev.fd, GLib.PRIORITY_DEFAULT,
                                        GLib.IO_IN | GLib.IO_ERR | GLib.IO_HUP, self._leer)
        debug(f"pad abierto: {dev.path} ({self.max_x}x{self.max_y})")
        return True

    def cerrar(self):
        if not self.dev:
            return
        if self.fuente:
            GLib.source_remove(self.fuente)
            self.fuente = 0
        try:
            self.dev.close()        # cerrar libera el grab
        except OSError:
            pass
        self.dev = None
        self.tomado = False
        self._reiniciar()
        debug("pad cerrado")

    def tomar(self, si):
        """Toma el pad en exclusiva (launcher) o lo deja libre (touchpad temporal)."""
        if not self.dev or self.tomado == si:
            return
        try:
            self.dev.grab() if si else self.dev.ungrab()
            self.tomado = si
            debug("pad tomado" if si else "pad libre")
        except OSError as e:
            log(f"no se pudo {'tomar' if si else 'liberar'} el pad: {e}")

    def _leer(self, _fd, _cond):
        try:
            for ev in self.dev.read():
                self._evento(ev)
        except BlockingIOError:
            pass
        except OSError as e:
            log(f"se perdió el pad: {e}")
            self.fuente = 0
            self.cerrar()
            return False
        return True

    def _evento(self, ev):
        if ev.type == ecodes.EV_ABS:
            c, v = ev.code, ev.value
            if c == ecodes.ABS_X:
                self.x = v
            elif c == ecodes.ABS_Y:
                self.y = v
            elif c == ecodes.ABS_MT_SLOT:
                self.slot = v
            elif c == ecodes.ABS_MT_TRACKING_ID:
                if v < 0:
                    self.dedos.pop(self.slot, None)
                else:
                    self.dedos[self.slot] = [self.x, self.y]
            elif c == ecodes.ABS_MT_POSITION_X and self.slot in self.dedos:
                self.dedos[self.slot][0] = v
            elif c == ecodes.ABS_MT_POSITION_Y and self.slot in self.dedos:
                self.dedos[self.slot][1] = v
        elif ev.type == ecodes.EV_KEY:
            if ev.code == ecodes.BTN_TOUCH:
                self.tocando = ev.value == 1
                if not self.tocando:
                    self._soltado()
            elif ev.code == ecodes.BTN_TOOL_QUADTAP and ev.value:
                self.max_dedos = max(self.max_dedos, 4)
            elif ev.code == ecodes.BTN_TOOL_QUINTTAP and ev.value:
                self.max_dedos = max(self.max_dedos, 5)
        elif ev.type == ecodes.EV_SYN and self.tocando:
            self._cuadro()

    def _a_ventana(self, x, y):
        w = self.launcher.ventana
        return (x / self.max_x * w.get_width(), y / self.max_y * w.get_height())

    def _cuadro(self):
        """Un cuadro completo del pad con al menos un dedo apoyado."""
        self.max_dedos = max(self.max_dedos, len(self.dedos), 1)
        if self.t_apoyo is None:
            self.t_apoyo = time.monotonic()
            self.launcher.al_apoyar()
        if not self.tomado:
            self.launcher.estela([(s, *self._a_ventana(*p)) for s, p in self.dedos.items()])
            return
        if self.max_dedos > 1:
            self._sin_objetivo()
            return
        pos = self._a_ventana(self.x, self.y)
        if self.inicio is None:
            self._apoyado(pos)
        else:
            self._movido(pos)

    def _apoyado(self, pos):
        self.inicio = self.ultimo = pos
        self.movido = False
        self.objetivo = self.launcher.accion_en(*pos)
        if self.objetivo and self.launcher.empezar_deslizable(self.objetivo, pos):
            self.objetivo = None
            self.movido = True
        elif self.objetivo:
            self.objetivo.add_css_class("presionado")
            self.largo = GLib.timeout_add(TOQUE_LARGO_MS, self._toque_largo)

    def arrastrar(self, mover, soltar):
        """Desde un toque largo: el resto del toque mueve y suelta lo arrastrado."""
        self.arrastre = (mover, soltar)

    def _movido(self, pos):
        if self.arrastre:
            self.ultimo = pos
            self.arrastre[0](pos)
            return
        if not self.movido and (abs(pos[0] - self.inicio[0]) > TOQUE_MOVER
                                or abs(pos[1] - self.inicio[1]) > TOQUE_MOVER):
            self.movido = True
            self._sin_objetivo()
        if self.movido:
            self.launcher.desplazar(*self.inicio, pos[1] - self.ultimo[1])
        self.ultimo = pos

    def _soltado(self):
        if self.arrastre:
            soltar, self.arrastre = self.arrastre[1], None
            soltar(self.ultimo)
            self._reiniciar()
            return
        duracion = time.monotonic() - self.t_apoyo if self.t_apoyo else 0
        if self.max_dedos >= 4 and duracion < CUATRO_DEDOS_S:
            debug("cuatro dedos")
            self._reiniciar()
            self.launcher.cuatro_dedos()
            return
        if self.tomado and self.objetivo and not self.movido and self.max_dedos == 1:
            debug(f"toque en {self.objetivo.get_name()}")
            self.launcher.activar(self.objetivo)
        elif self.tomado and self.movido and self.max_dedos == 1 and self.inicio and self.ultimo:
            dx = self.ultimo[0] - self.inicio[0]
            dy = self.ultimo[1] - self.inicio[1]
            if abs(dx) > DESLIZAR and abs(dx) > 2 * abs(dy):
                self.launcher.deslizar(1 if dx < 0 else -1)
        self._reiniciar()
        self.launcher.al_soltar()

    def _toque_largo(self):
        self.largo = 0
        if self.objetivo:
            debug(f"toque largo en {self.objetivo.get_name()}")
            self.launcher.activar(self.objetivo, largo=True)
        self._sin_objetivo()
        self.movido = True          # al soltar no cuenta como toque
        return False

    def _sin_objetivo(self):
        if self.largo:
            GLib.source_remove(self.largo)
            self.largo = 0
        if self.objetivo:
            self.objetivo.remove_css_class("presionado")
            self.objetivo = None

    def _reiniciar(self):
        if self.arrastre:
            soltar, self.arrastre = self.arrastre[1], None
            soltar(None)            # cancelado
        self._sin_objetivo()
        self.inicio = self.ultimo = self.t_apoyo = None
        self.movido = False
        self.max_dedos = 0


class Estela(Gtk.Widget):
    """Dibuja por dónde pasan los dedos; cada punto se desvanece en ESTELA_S."""

    def __init__(self):
        super().__init__(can_target=False, hexpand=True, vexpand=True)
        self.trazos = {}            # slot -> [(x, y, t)]
        self.tic = 0

    def agregar(self, puntos):
        ahora = time.monotonic()
        for slot, x, y in puntos:
            self.trazos.setdefault(slot, []).append((x, y, ahora))
        if not self.tic:
            self.tic = self.add_tick_callback(self._tic)

    def limpiar(self):
        self.trazos.clear()
        self.queue_draw()

    def _tic(self, _w, _reloj):
        limite = time.monotonic() - ESTELA_S
        for slot in list(self.trazos):
            self.trazos[slot] = [p for p in self.trazos[slot] if p[2] > limite]
            if not self.trazos[slot]:
                del self.trazos[slot]
        self.queue_draw()
        if not self.trazos:
            self.tic = 0
            return False
        return True

    def do_snapshot(self, snap):
        ahora = time.monotonic()
        for puntos in self.trazos.values():
            for (x0, y0, _), (x1, y1, t) in zip([puntos[0], *puntos], puntos):
                vida = max(0.0, 1 - (ahora - t) / ESTELA_S)
                b = Gsk.PathBuilder.new()
                b.move_to(x0, y0)
                b.line_to(x1, y1)
                trazo = Gsk.Stroke.new(4 + 10 * vida)
                trazo.set_line_cap(Gsk.LineCap.ROUND)
                c = Gdk.RGBA()
                c.red = c.green = c.blue = 1.0
                c.alpha = 0.55 * vida
                snap.append_stroke(b.to_path(), trazo, c)


class Wayland:
    """Cliente Wayland propio (formato binario del protocolo) para listar y manejar
    ventanas en COSMIC; solo los mensajes que usa el launcher."""

    # firmas de los eventos: i int, u uint, s texto, o objeto, n objeto nuevo, a arreglo
    EVENTOS = {
        "wl_display": [("error", "ous"), ("delete_id", "u")],
        "wl_registry": [("global", "usu"), ("global_remove", "u")],
        "wl_callback": [("done", "u")],
        "wl_seat": [("capabilities", "u"), ("name", "s")],
        "wl_output": [("geometry", "iiiiissi"), ("mode", "uiii"), ("done", ""), ("scale", "i"),
                      ("name", "s"), ("description", "s")],
        "ext_foreign_toplevel_list_v1": [("toplevel", "n"), ("finished", "")],
        "ext_foreign_toplevel_handle_v1": [("closed", ""), ("done", ""), ("title", "s"),
                                           ("app_id", "s"), ("identifier", "s")],
        "zcosmic_toplevel_info_v1": [("toplevel", "n"), ("finished", ""), ("done", "")],
        "zcosmic_toplevel_handle_v1": [
            ("closed", ""), ("done", ""), ("title", "s"), ("app_id", "s"),
            ("output_enter", "o"), ("output_leave", "o"), ("workspace_enter", "o"),
            ("workspace_leave", "o"), ("state", "a"), ("geometry", "oiiii"),
            ("ext_workspace_enter", "o"), ("ext_workspace_leave", "o")],
        "zcosmic_toplevel_manager_v1": [("capabilities", "a")],
        "ext_workspace_manager_v1": [("workspace_group", "n"), ("workspace", "n"), ("done", ""),
                                     ("finished", "")],
        "ext_workspace_group_handle_v1": [("capabilities", "u"), ("output_enter", "o"),
                                          ("output_leave", "o"), ("workspace_enter", "o"),
                                          ("workspace_leave", "o"), ("removed", "")],
        "ext_workspace_handle_v1": [("id", "s"), ("name", "s"), ("coordinates", "a"),
                                    ("state", "u"), ("capabilities", "u"), ("removed", "")],
    }
    # interfaz de los objetos que crea el compositor en un evento "n"
    NUEVOS = {("ext_foreign_toplevel_list_v1", "toplevel"): "ext_foreign_toplevel_handle_v1",
              ("zcosmic_toplevel_info_v1", "toplevel"): "zcosmic_toplevel_handle_v1",
              ("ext_workspace_manager_v1", "workspace_group"): "ext_workspace_group_handle_v1",
              ("ext_workspace_manager_v1", "workspace"): "ext_workspace_handle_v1"}
    # globales que se enlazan, con la versión máxima que entiende este cliente
    GLOBALES = {"wl_seat": 1, "wl_output": 4, "ext_foreign_toplevel_list_v1": 1,
                "zcosmic_toplevel_info_v1": 3, "zcosmic_toplevel_manager_v1": 4,
                "ext_workspace_manager_v1": 1}
    ESTADOS = {0: "maximizada", 1: "minimizada", 2: "activa", 3: "pantalla completa"}

    def __init__(self, al_cambiar):
        self.al_cambiar = al_cambiar
        self.objetos = {1: "wl_display"}
        self.siguiente = 2
        self.globales = {}          # interfaz -> id de nuestro objeto
        self.salidas = {}           # id wl_output -> nombre del conector
        self.ventanas = {}          # id cosmic -> datos
        self.de_foreign = {}        # id ext_foreign -> id cosmic
        self.grupos = {}            # id grupo -> {"salidas": set, "espacios": set}
        self.espacios = {}          # id espacio -> estado
        self.buf = b""
        self.aviso = 0
        self.sock = None
        ruta = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
        if not ruta.startswith("/"):
            ruta = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), ruta)
        try:
            self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            self.sock.connect(ruta)
        except OSError as e:
            log(f"sin conexión Wayland para las ventanas: {e}")
            self.sock = None
            return
        self.sock.setblocking(False)
        self.fuente = GLib.io_add_watch(self.sock.fileno(), GLib.PRIORITY_DEFAULT,
                                        GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self._leer)
        self.registro = self._nuevo("wl_registry")
        self._enviar(1, 1, self._u(self.registro))         # wl_display.get_registry

    # ----- formato del protocolo

    @staticmethod
    def _u(v):
        return struct.pack("=I", v & 0xFFFFFFFF)

    @staticmethod
    def _texto(t):
        b = t.encode() + b"\0"
        return Wayland._u(len(b)) + b + b"\0" * (-len(b) % 4)

    def _nuevo(self, interfaz):
        i = self.siguiente
        self.siguiente += 1
        self.objetos[i] = interfaz
        return i

    def _enviar(self, objeto, opcode, *partes):
        if not self.sock:
            return
        datos = b"".join(partes)
        try:
            self.sock.sendall(self._u(objeto) + self._u(((8 + len(datos)) << 16) | opcode) + datos)
        except OSError as e:
            log(f"Wayland (ventanas): {e}")

    def _leer(self, _fd, condicion):
        try:
            datos = self.sock.recv(65536)
        except BlockingIOError:
            return True
        except OSError:
            datos = b""
        if not datos:
            log("se cerró la conexión Wayland de las ventanas")
            self.sock = None
            return False
        self.buf += datos
        while len(self.buf) >= 8:
            objeto, op = struct.unpack_from("=II", self.buf)
            largo, opcode = op >> 16, op & 0xFFFF
            if len(self.buf) < largo:
                break
            cuerpo, self.buf = self.buf[8:largo], self.buf[largo:]
            self._evento(objeto, opcode, cuerpo)
        return True

    def _evento(self, objeto, opcode, cuerpo):
        interfaz = self.objetos.get(objeto)
        tabla = self.EVENTOS.get(interfaz)
        if not tabla or opcode >= len(tabla):
            return
        nombre, firma = tabla[opcode]
        args, pos = [], 0
        for t in firma:
            if t in "uon":
                args.append(struct.unpack_from("=I", cuerpo, pos)[0])
                pos += 4
            elif t == "i":
                args.append(struct.unpack_from("=i", cuerpo, pos)[0])
                pos += 4
            elif t in "sa":
                n = struct.unpack_from("=I", cuerpo, pos)[0]
                crudo = cuerpo[pos + 4:pos + 4 + n]
                args.append(crudo[:-1].decode(errors="replace") if t == "s" and n else
                            ("" if t == "s" else crudo))
                pos += 4 + n + (-n % 4)
            if t == "n":
                self.objetos[args[-1]] = self.NUEVOS[(interfaz, nombre)]
        manejador = getattr(self, f"_{interfaz}_{nombre}", None)
        if manejador:
            manejador(objeto, *args)

    # ----- eventos

    def _wl_display_error(self, _o, objeto, codigo, mensaje):
        log(f"error Wayland en {self.objetos.get(objeto)}#{objeto} ({codigo}): {mensaje}")

    def _wl_registry_global(self, _o, nombre, interfaz, version):
        if interfaz not in self.GLOBALES:
            return
        if interfaz != "wl_output" and interfaz in self.globales:
            return
        v = min(version, self.GLOBALES[interfaz])
        i = self._nuevo(interfaz)
        self._enviar(self.registro, 0, self._u(nombre), self._texto(interfaz), self._u(v),
                     self._u(i))
        if interfaz == "wl_output":
            self.salidas[i] = ""
        else:
            self.globales[interfaz] = i

    def _wl_output_name(self, o, nombre):
        self.salidas[o] = nombre

    def _ext_foreign_toplevel_list_v1_toplevel(self, _o, foreign):
        info = self.globales.get("zcosmic_toplevel_info_v1")
        if not info:
            return
        c = self._nuevo("zcosmic_toplevel_handle_v1")
        self._enviar(info, 1, self._u(c), self._u(foreign))   # get_cosmic_toplevel
        self.de_foreign[foreign] = c
        self.ventanas[c] = {"titulo": "", "app_id": "", "estados": set(), "salidas": set(),
                            "foreign": foreign, "lista": False, "id": ""}

    def _ext_foreign_toplevel_handle_v1_closed(self, f, *_):
        self._enviar(f, 0)                                      # destroy
        self.objetos.pop(f, None)
        c = self.de_foreign.pop(f, None)
        if c in self.ventanas:
            del self.ventanas[c]
            self._enviar(c, 0)
            self.objetos.pop(c, None)
            self._avisar()

    # Con zcosmic_toplevel_info v2+, título, app y "done" llegan por el handle de
    # ext_foreign_toplevel; el de COSMIC solo trae estado, salida y espacio de trabajo.

    def _ext_foreign_toplevel_handle_v1_title(self, f, t):
        c = self.de_foreign.get(f)
        if c in self.ventanas:
            self.ventanas[c]["titulo"] = t

    def _ext_foreign_toplevel_handle_v1_app_id(self, f, a):
        c = self.de_foreign.get(f)
        if c in self.ventanas:
            self.ventanas[c]["app_id"] = a

    def _ext_foreign_toplevel_handle_v1_identifier(self, f, ident):
        c = self.de_foreign.get(f)
        if c in self.ventanas:
            self.ventanas[c]["id"] = ident

    def _ext_foreign_toplevel_handle_v1_done(self, f):
        c = self.de_foreign.get(f)
        if c in self.ventanas:
            self.ventanas[c]["lista"] = True
            self._avisar()

    def _zcosmic_toplevel_handle_v1_output_enter(self, c, s):
        if c in self.ventanas:
            self.ventanas[c]["salidas"].add(s)
            self._avisar()

    def _zcosmic_toplevel_handle_v1_output_leave(self, c, s):
        if c in self.ventanas:
            self.ventanas[c]["salidas"].discard(s)
            self._avisar()

    def _zcosmic_toplevel_handle_v1_state(self, c, arreglo):
        if c in self.ventanas:
            valores = struct.unpack(f"={len(arreglo) // 4}I", arreglo)
            self.ventanas[c]["estados"] = {self.ESTADOS.get(v, str(v)) for v in valores}
            self._avisar()

    def _ext_workspace_manager_v1_workspace_group(self, _o, g):
        self.grupos[g] = {"salidas": set(), "espacios": set()}

    def _ext_workspace_manager_v1_workspace(self, _o, w):
        self.espacios[w] = 0

    def _ext_workspace_group_handle_v1_output_enter(self, g, s):
        self.grupos.setdefault(g, {"salidas": set(), "espacios": set()})["salidas"].add(s)

    def _ext_workspace_group_handle_v1_output_leave(self, g, s):
        if g in self.grupos:
            self.grupos[g]["salidas"].discard(s)

    def _ext_workspace_group_handle_v1_workspace_enter(self, g, w):
        self.grupos.setdefault(g, {"salidas": set(), "espacios": set()})["espacios"].add(w)

    def _ext_workspace_group_handle_v1_workspace_leave(self, g, w):
        if g in self.grupos:
            self.grupos[g]["espacios"].discard(w)

    def _ext_workspace_group_handle_v1_removed(self, g):
        self.grupos.pop(g, None)

    def _ext_workspace_handle_v1_state(self, w, estado):
        self.espacios[w] = estado

    def _ext_workspace_handle_v1_removed(self, w):
        self.espacios.pop(w, None)

    def _avisar(self):
        # muchos "done" llegan juntos: se agrupan en un solo aviso
        if not self.aviso:
            self.aviso = GLib.timeout_add(80, self._fin_aviso)

    def _fin_aviso(self):
        self.aviso = 0
        self.al_cambiar()
        return False

    # ----- consultas y órdenes

    def disponible(self):
        return bool(self.sock and "zcosmic_toplevel_manager_v1" in self.globales)

    def lista(self):
        return [(c, v) for c, v in self.ventanas.items() if v["lista"]]

    def salida(self, c):
        """Nombre del conector donde está la ventana (la primera, si toca varias)."""
        for s in self.ventanas.get(c, {}).get("salidas", ()):
            return self.salidas.get(s, "")
        return ""

    def _gestor(self, opcode, c, *extra):
        g = self.globales.get("zcosmic_toplevel_manager_v1")
        if g and c in self.ventanas:
            self._enviar(g, opcode, self._u(c), *extra)

    def activar(self, c):
        if "minimizada" in self.ventanas.get(c, {}).get("estados", ()):
            self._gestor(6, c)                                  # unset_minimized
        seat = self.globales.get("wl_seat")
        if seat:
            self._gestor(2, c, self._u(seat))                   # activate

    def minimizar(self, c, si):
        self._gestor(5 if si else 6, c)

    def cerrar(self, c):
        self._gestor(1, c)

    def sin_pantalla_completa(self, c):
        self._gestor(8, c)                                      # unset_fullscreen

    def mover(self, c, conector):
        """A la salida 'conector', en el espacio de trabajo activo de esa salida."""
        salida = next((s for s, n in self.salidas.items() if n == conector), None)
        if salida is None:
            return False
        grupo = next((g for g in self.grupos.values() if salida in g["salidas"]), None)
        if not grupo or not grupo["espacios"]:
            return False
        espacio = next((w for w in grupo["espacios"] if self.espacios.get(w, 0) & 1),
                       next(iter(grupo["espacios"])))
        self._gestor(13, c, self._u(espacio), self._u(salida))  # move_to_ext_workspace
        return True


class Ecualizador(Gtk.Widget):
    """Cuatro barras que se mueven mientras suena algo y quedan quietas en pausa."""

    QUIETAS = (0.35, 0.6, 0.45, 0.3)

    def __init__(self):
        super().__init__(valign=Gtk.Align.CENTER, can_target=False)
        self.activo = False
        self.tic = 0

    def do_measure(self, _orientacion, _para):
        return 52, 52, -1, -1

    def activar(self, si):
        self.activo = si
        if si and not self.tic:
            # 20 cuadros por segundo
            self.tic = GLib.timeout_add(50, self._tic)
        self.queue_draw()

    def _tic(self):
        if self.get_mapped():
            self.queue_draw()
        if not self.activo:
            self.tic = 0
            return False
        return True

    def do_snapshot(self, snap):
        w, h = self.get_width(), self.get_height()
        ancho = w / 7
        t = time.monotonic()
        c = Gdk.RGBA()
        c.parse("#4d9bff" if self.activo else "rgba(255,255,255,0.6)")
        for i in range(4):
            f = (0.25 + 0.75 * abs(math.sin(t * 3.2 + i * 1.4)) if self.activo
                 else self.QUIETAS[i])
            alto = h * f
            snap.append_color(c, Graphene.Rect().init(i * 2 * ancho, h - alto, ancho, alto))


class Marquesina(Gtk.ScrolledWindow):
    """Una línea de texto que, si no cabe, se desplaza de ida y vuelve al inicio."""

    PASO_PX = 2
    PAUSA_TICS = 45             # tics de 40 ms en cada extremo

    def __init__(self):
        super().__init__(hscrollbar_policy=Gtk.PolicyType.EXTERNAL,
                         vscrollbar_policy=Gtk.PolicyType.NEVER, max_content_width=380,
                         propagate_natural_width=True, propagate_natural_height=True,
                         can_target=False, valign=Gtk.Align.CENTER)
        self.etiqueta = Gtk.Label(css_classes=["titulo-musica"], xalign=0)
        self.set_child(self.etiqueta)
        self.pausa = self.PAUSA_TICS
        GLib.timeout_add(40, self._tic)

    def poner(self, texto):
        if texto != self.etiqueta.get_label():
            self.etiqueta.set_label(texto)
            self.get_hadjustment().set_value(0)
            self.pausa = self.PAUSA_TICS

    def _tic(self):
        if not self.get_mapped():
            return True
        aj = self.get_hadjustment()
        maximo = aj.get_upper() - aj.get_page_size()
        if maximo <= 0:
            return True
        if self.pausa:
            self.pausa -= 1
            if not self.pausa and aj.get_value() >= maximo:
                aj.set_value(0)
                self.pausa = self.PAUSA_TICS
            return True
        aj.set_value(min(maximo, aj.get_value() + self.PASO_PX))
        if aj.get_value() >= maximo:
            self.pausa = self.PAUSA_TICS
        return True


