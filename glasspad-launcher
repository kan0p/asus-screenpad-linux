    def _mostrar_brillo(self):
        """Lee el brillo de glasspadd (la caché del proxy no se actualiza sola)."""
        nivel = self.brillo
        if self.servicio:
            try:
                r = self.servicio.get_connection().call_sync(
                    BUS, RUTA, "org.freedesktop.DBus.Properties", "Get",
                    GLib.Variant("(ss)", (BUS, "Brightness")), GLib.VariantType("(v)"),
                    Gio.DBusCallFlags.NONE, 500, None)
                nivel = r.unpack()[0]
            except GLib.Error:
                pass
        self.brillo = nivel
        self.leyendo_brillo = True
        self.escala.set_value(nivel)
        self.leyendo_brillo = False
        self.pct.set_label(f"{round(nivel * 100 / 255)}%")

    def _brillo_en(self, fraccion):
        self.escala.set_value(1 + fraccion * 254)

    def _brillo_cambiado(self, escala):
        nivel = round(escala.get_value())
        self.pct.set_label(f"{round(nivel * 100 / 255)}%")
        if self.leyendo_brillo or nivel == self.brillo:
            return
        self.brillo = nivel
        if self.servicio:
            self.servicio.call("SetBrightness", GLib.Variant("(u)", (nivel,)),
                               Gio.DBusCallFlags.NONE, 1000, None, None)

    def _bloquear(self):
        self._cerrar_centro()
        try:
