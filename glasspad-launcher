    def _iniciar_musica(self):
        if Playerctl is None:
            log("sin Playerctl: no hay controles de música")
            return
        self.gestor = Playerctl.PlayerManager()
        self.gestor.connect("name-appeared", lambda _g, n: self._agregar_reproductor(n))
        self.gestor.connect("player-vanished", lambda *_: self._musica_cambio())
        for n in self.gestor.props.player_names:
            self._agregar_reproductor(n)
        GLib.timeout_add_seconds(30, lambda: self._musica_cambio() or True)

    def _agregar_reproductor(self, nombre):
        try:
            p = Playerctl.Player.new_from_name(nombre)
        except GLib.Error as e:
            log(f"reproductor {nombre.name}: {e.message}")
            return
        for senal in ("playback-status", "metadata", "seeked", "shuffle", "loop-status"):
            p.connect(senal, lambda *_: self._musica_cambio())
        self.gestor.manage_player(p)
        self._musica_cambio()

    def _reproductores(self):
        return list(self.gestor.props.players) if self.gestor else []

    def _sonando(self, p):
        try:
            return p.props.playback_status == Playerctl.PlaybackStatus.PLAYING
        except GLib.Error:
            return False

    def _detenido(self, p):
        try:
            return p.props.playback_status == Playerctl.PlaybackStatus.STOPPED
        except GLib.Error:
            return True

    def _actual(self):
        """El reproductor elegido; si no hay elección, el que suena o el primero que no
        está detenido."""
        lista = [p for p in self._reproductores() if not self._detenido(p)]
        for p in lista:
            if p.props.player_instance == self.elegido:
                return p
        return next((p for p in lista if self._sonando(p)), lista[0] if lista else None)

    def _musica_cambio(self):
        ahora = time.monotonic()
        visibles = []
        for p in self._reproductores():
            inst = p.props.player_instance
            if self._sonando(p):
                self.pausado_desde.pop(inst, None)
                visibles.append(p)
            elif self._detenido(p):
                # detenido: no hay nada que controlar
                self.pausado_desde.pop(inst, None)
            else:
                desde = self.pausado_desde.setdefault(inst, ahora)
                if ahora - desde < MUSICA_OCULTAR_S:
                    visibles.append(p)
        p = self._actual()
        if not self.ventana:
            return
        mostrar = bool(visibles) and p is not None and not self._detenido(p)
        self.boton_musica.set_visible(mostrar)
        if mostrar:
            self.ecualizador.activar(self._sonando(p))
            self.marquesina.poner(titulo_de(p))
        if not mostrar:
            self._cerrar_musica()
        elif self.velo_musica.get_visible():
            self._llenar_musica()

