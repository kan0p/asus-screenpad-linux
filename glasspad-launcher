            for c, v in ventanas:
                grilla.append(self._tarjeta_ventana(c, v, nombre == "ScreenPad"))
            self.lista_ventanas.append(grilla)

    def _tarjeta_ventana(self, c, v, en_pad):
        app = self._app_de(v["app_id"])
        icono = (app.get_icon() if app else None) or Gio.ThemedIcon.new_with_default_fallbacks(
            v["app_id"] or "application-x-executable")
        img = Gtk.Image.new_from_gicon(icono)
        img.add_css_class("icono-ventana")
        minimizada = "minimizada" in v["estados"]
        nombre = app.get_display_name() if app else v["app_id"]
        textos = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                         valign=Gtk.Align.CENTER, hexpand=True)
        textos.append(Gtk.Label(label=v["titulo"] or nombre, xalign=0, wrap=True, lines=2,
                                ellipsize=3, natural_wrap_mode=Gtk.NaturalWrapMode.WORD,
                                max_width_chars=1, hexpand=True, css_classes=["v-titulo"]))
        textos.append(Gtk.Label(label=" · ".join(x for x in (
            nombre, "minimizada" if minimizada else "") if x), xalign=0, ellipsize=3,
            max_width_chars=1, hexpand=True, css_classes=["v-app"]))
        arriba = Gtk.Box(spacing=26)
        arriba.append(img)
        arriba.append(textos)

        botones = Gtk.Box(spacing=16, halign=Gtk.Align.END)
        botones.append(self._control(
            "window-restore-symbolic" if minimizada else "window-minimize-symbolic",
            lambda: self.wl.minimizar(c, not minimizada), ("chico",)))
        botones.append(self._control("go-up-symbolic" if en_pad else "go-down-symbolic",
                                     lambda: self._mover_ventana(c, en_pad), ("chico",)))
        botones.append(self._control("window-close-symbolic", lambda: self.wl.cerrar(c),
                                     ("chico", "peligro")))
        tarjeta = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=22,
                          css_classes=["ventana"])
        if "activa" in v["estados"]:
            tarjeta.add_css_class("activa")
        if minimizada:
            tarjeta.add_css_class("minimizada")
        tarjeta.append(arriba)
        tarjeta.append(botones)
        return self._accion(tarjeta, lambda: self.wl.activar(c))

    def _mover_ventana(self, c, desde_pad):
        pad = self._conector_pad()
        if desde_pad:
            destino = next((n for n in self.wl.salidas.values() if n and n != pad), "")
        else:
            destino = pad
        if not destino or not self.wl.mover(c, destino):
            self._avisar("No se pudo mover la ventana")
            return
        if not desde_pad:
            # en modo launcher el pad está cubierto: pasa a monitor
            self._avisar("Ventana en el ScreenPad: pasando a modo monitor")
            GLib.timeout_add(900, lambda: self._pedir_modo("monitor") and False)

    def _sacar_del_pad(self):
        """Fuera del modo monitor el pad no se ve: sus ventanas pasan a la principal."""
        pad = self._conector_pad()
        principal = next((n for n in self.wl.salidas.values() if n and n != pad), "")
        if not pad or not principal:
            return
        movidas = set()
        for c, v in self.wl.lista():
            if self.wl.salida(c) != pad:
                continue
            if "pantalla completa" in v["estados"]:
                self.wl.sin_pantalla_completa(c)
            if self.wl.mover(c, principal) and v["id"]:
                movidas.add(v["id"])
        if movidas:
            debug(f"{len(movidas)} ventanas del pad a {principal}")
            self.del_pad |= movidas
            guardar_ventanas_pad(self.del_pad)

    def _devolver_al_pad(self, intentos=10):
        """Al volver a monitor, las ventanas que estaban en el pad regresan a él."""
        if self.reintento_pad:
            GLib.source_remove(self.reintento_pad)
            self.reintento_pad = 0
        if not self.del_pad:
            return
        pad = self._conector_pad()
        lista = self.wl.lista()
        listo = pad in self.wl.salidas.values() and lista and any(
            pad in (self.wl.salidas.get(o) for o in g["salidas"]) for g in self.wl.grupos.values())
        if not listo:
            # la salida del pad o la lista de ventanas todavía no llegaron
            if intentos > 0 and self.modo == "monitor":
                self.reintento_pad = GLib.timeout_add(1000, self._reintentar_pad, intentos - 1)
            return
        for c, v in lista:
            if v["id"] in self.del_pad and self.wl.salida(c) != pad:
                self.wl.mover(c, pad)
        debug("ventanas devueltas al pad")
        self.del_pad = set()
        guardar_ventanas_pad(self.del_pad)

    def _reintentar_pad(self, intentos):
        self.reintento_pad = 0
        if self.modo == "monitor":
            self._devolver_al_pad(intentos)
        return False

    def _app_de(self, app_id):
        """La app (.desktop) de una ventana, por id o por StartupWMClass."""
        if not app_id:
            return None
        if app_id in self.apps_por_id:
            return self.apps_por_id[app_id]
        app = None
        for candidato in (app_id, app_id.lower()):
            try:
                app = DesktopAppInfo.new(candidato + ".desktop")
            except TypeError:
                app = None
            if app:
                break
        if app is None:
            clave = app_id.lower()
            for a in Gio.AppInfo.get_all():
                clase = (a.get_startup_wm_class() or "").lower() if hasattr(
                    a, "get_startup_wm_class") else ""
                if clase == clave or (a.get_id() or "").lower().removesuffix(".desktop") == clave:
                    app = a
                    break
        self.apps_por_id[app_id] = app
        return app

    def _ventana_de_reproductor(self, p):
        """La ventana de la app que reproduce (brave -> brave-browser), si hay una."""
        nombre = p.props.player_name.lower()
        for c, v in self.wl.lista() if self.wl else []:
            if nombre and nombre in v["app_id"].lower():
                return c
        return None

