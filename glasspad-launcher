    def _pagina_calendario(self):
        hoy = datetime.date.today()
        self.mes = (hoy.year, hoy.month)
        cabecera = Gtk.CenterBox()
        flechas = Gtk.Box(spacing=18)
        flechas.append(self._control("go-previous-symbolic", lambda: self._cambiar_mes(-1)))
        flechas.append(self._control("go-next-symbolic", lambda: self._cambiar_mes(1)))
        cabecera.set_start_widget(flechas)
        self.titulo_mes = Gtk.Label(css_classes=["titulo-mes"])
        cabecera.set_center_widget(self.titulo_mes)
        cabecera.set_end_widget(self._accion(Gtk.Button(label="Hoy", css_classes=["chip"],
                                                        valign=Gtk.Align.CENTER),
                                             self._mes_actual))
        self.grilla_mes = Gtk.Grid(column_homogeneous=True, row_homogeneous=True,
                                   column_spacing=10, row_spacing=6, vexpand=True)
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=22,
                       css_classes=["teclado", "calendario"])
        caja.append(cabecera)
        caja.append(self.grilla_mes)
        self.paginas.connect("notify::visible-child-name", lambda p, _: (
            self._mes_actual() if p.get_visible_child_name() == "calendario" else None))
        self._llenar_mes()
        return caja

    def _llenar_mes(self):
        anio, mes = self.mes
        self.titulo_mes.set_label(f"{MESES[mes - 1].capitalize()} {anio}")
        self._vaciar(self.grilla_mes)
        for i, d in enumerate(DIAS):
            self.grilla_mes.attach(Gtk.Label(label=d[:3], css_classes=["dia-semana"]), i, 0, 1, 1)
        semanas = calendar.Calendar(0).monthdatescalendar(anio, mes)
        hoy = datetime.date.today()
        for f, semana in enumerate(semanas):
            for c, dia in enumerate(semana):
                clases = ["dia"]
                if dia.month != mes:
                    clases.append("fuera")
                if dia == hoy:
                    clases.append("hoy")
                if c >= 5:
                    clases.append("finde")
                etiqueta = Gtk.Label(label=str(dia.day), css_classes=clases,
                                     halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
                self.grilla_mes.attach(etiqueta, c, f + 1, 1, 1)

    def _cambiar_mes(self, paso):
        anio, mes = self.mes
        mes += paso
        anio, mes = anio + (mes - 1) // 12, (mes - 1) % 12 + 1
        self.mes = (anio, mes)
        self._llenar_mes()

    def _mes_actual(self):
        hoy = datetime.date.today()
        self.mes = (hoy.year, hoy.month)
        self._llenar_mes()

