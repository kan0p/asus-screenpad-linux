    return f"{s // 3600}:{s // 60 % 60:02d}:{s % 60:02d}" if s >= 3600 else f"{s // 60}:{s % 60:02d}"


def leer_ventanas_pad():
    try:
        with open(VENTANAS_PAD) as f:
            ids = json.load(f)
        return {i for i in ids if isinstance(i, str)} if isinstance(ids, list) else set()
    except (FileNotFoundError, ValueError, OSError):
        return set()


def guardar_ventanas_pad(ids):
    os.makedirs(os.path.dirname(VENTANAS_PAD), exist_ok=True)
    tmp = VENTANAS_PAD + ".tmp"
    with open(tmp, "w") as f:
        json.dump(sorted(ids), f)
    os.replace(tmp, VENTANAS_PAD)


def guardar_inicio(ids, ofrecidas=None):
    if ofrecidas is None:
        try:
            with open(INICIO) as f:
                ofrecidas = set(json.load(f).get("ofrecidas", []))
        except (FileNotFoundError, ValueError, OSError, AttributeError):
            ofrecidas = set()
    os.makedirs(os.path.dirname(INICIO), exist_ok=True)
    tmp = INICIO + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"inicio": ids, "ofrecidas": sorted(ofrecidas)}, f)
    os.replace(tmp, INICIO)


def buscar_salida(conf):
    """El monitor del ScreenPad: el de la config, el último de 'screenpad on' o el Toshiba."""
    nombre = conf["output"]
    if not nombre:
        try:
            with open(CONECTOR) as f:
                nombre = f.read().strip()
        except OSError:
            pass
    monitores = Gdk.Display.get_default().get_monitors()
    for i in range(monitores.get_n_items()):
        m = monitores.get_item(i)
        if nombre and m.get_connector() == nombre:
            return m
        if not nombre and "Toshiba" in (m.get_manufacturer() or ""):
            return m
    return None


def buscar_pad(nombre):
    for ruta in evdev.list_devices():
        try:
            d = evdev.InputDevice(ruta)
        except OSError:
            continue
        if d.name == nombre:
            return d
        d.close()
    return None


