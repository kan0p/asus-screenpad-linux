    def _control(self, icono, accion, clases=()):
        return self._accion(Gtk.Button(icon_name=icono, css_classes=["control", *clases]),
                            accion)

    def _alternar_musica(self):
        if self.velo_musica.get_visible():
            self._cerrar_musica()
        else:
            self._cerrar_centro()
            self._cerrar_hoja()
            self._leer_volumen()
            self._llenar_musica()
            self.velo_musica.set_visible(True)
            if not self.tic_musica:
                self.tic_musica = GLib.timeout_add(500, self._tic_progreso)

    def _cerrar_musica(self):
        if self.ventana:
            self.velo_musica.set_visible(False)
        if self.tic_musica:
            GLib.source_remove(self.tic_musica)
            self.tic_musica = 0

    def _llenar_musica(self):
        p = self._actual()
        if p is None:
            return
        self._vaciar(self.fichas)
        lista = [o for o in self._reproductores() if not self._detenido(o)]
        self.fichas.set_visible(len(lista) > 1)
        for otro in lista:
            ficha = self._accion(
                Gtk.Button(label=nombre_reproductor(otro), css_classes=["chip"]),
                lambda o=otro: self._elegir(o))
            if otro.props.player_instance == p.props.player_instance:
                ficha.add_css_class("activo")
            self.fichas.append(ficha)
        self.m_titulo.set_label(titulo_de(p) or "Sin título")
        artista = p.get_artist() or ""
        self.m_artista.set_label(" · ".join(x for x in (artista, nombre_reproductor(p)) if x))
        arte = p.print_metadata_prop("mpris:artUrl") or ""
        ruta = Gio.File.new_for_uri(arte).get_path() if arte.startswith("file://") else None
        if ruta and os.path.isfile(ruta):
            self.caratula_img.set_filename(ruta)
            self.caratula.set_visible_child_name("imagen")
        else:
            self.caratula.set_visible_child_name("nota")
        self.m_play.set_icon_name("media-playback-pause-symbolic" if self._sonando(p)
                                  else "media-playback-start-symbolic")
        self.m_anterior.set_sensitive(bool(p.props.can_go_previous))
        self.m_siguiente.set_sensitive(bool(p.props.can_go_next))
        self.m_aleatorio.set_visible(self._admite(p, "Shuffle"))
        self.m_repetir.set_visible(self._admite(p, "LoopStatus"))
        if self.m_aleatorio.get_visible():
            self._marcar(self.m_aleatorio, bool(p.props.shuffle))
        if self.m_repetir.get_visible():
            bucle = p.props.loop_status
            self._marcar(self.m_repetir, bucle != Playerctl.LoopStatus.NONE)
            self.m_repetir.set_icon_name("media-playlist-repeat-song-symbolic"
                                         if bucle == Playerctl.LoopStatus.TRACK
                                         else "media-playlist-repeat-symbolic")
        self.m_ir.set_visible(self._admite(p, "CanRaise", "org.mpris.MediaPlayer2", True)
                              or self._ventana_de_reproductor(p) is not None)
        self._tic_progreso()

    def _marcar(self, boton, activo):
        if activo:
            boton.add_css_class("activo")
        else:
            boton.remove_css_class("activo")

    def _admite(self, p, prop, interfaz="org.mpris.MediaPlayer2.Player", valor=None):
        """Si el reproductor publica la propiedad (o si vale 'valor', cuando se da)."""
        try:
            r = self.bus.call_sync(
                "org.mpris.MediaPlayer2." + p.props.player_instance, "/org/mpris/MediaPlayer2",
                "org.freedesktop.DBus.Properties", "Get", GLib.Variant("(ss)", (interfaz, prop)),
                GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 300, None).unpack()[0]
        except GLib.Error:
            return False
        return True if valor is None else r == valor

    def _elegir(self, p):
        self.elegido = p.props.player_instance
        self._musica_cambio()
        self._llenar_musica()

    def _mpris(self, metodo):
        p = self._actual()
        if p:
            try:
                getattr(p, metodo)()
            except GLib.Error as e:
                log(f"{metodo}: {e.message}")

    def _alternar_aleatorio(self):
        p = self._actual()
        if p:
            try:
                p.set_shuffle(not p.props.shuffle)
            except GLib.Error as e:
                log(f"aleatorio: {e.message}")

    def _alternar_repetir(self):
        p = self._actual()
        if not p:
            return
        L = Playerctl.LoopStatus
        sigue = {L.NONE: L.PLAYLIST, L.PLAYLIST: L.TRACK, L.TRACK: L.NONE}
        try:
            p.set_loop_status(sigue.get(p.props.loop_status, L.NONE))
        except GLib.Error as e:
            log(f"repetir: {e.message}")

    def _ir_a_app(self):
        p = self._actual()
        c = self._ventana_de_reproductor(p) if p else None
        if c is not None:
            self.wl.activar(c)
            self._cerrar_musica()
        elif p:
            self.bus.call("org.mpris.MediaPlayer2." + p.props.player_instance,
                          "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2", "Raise", None,
                          None, Gio.DBusCallFlags.NONE, 1000, None, None)
            self._cerrar_musica()

    # progreso

    def _tic_progreso(self):
        p = self._actual()
        if p is None or self.buscando:
            return True
        largo = metadato_entero(p, "mpris:length")
        try:
            pos = p.get_position()
        except GLib.Error:
            pos = 0
        self.m_progreso.set_sensitive(bool(largo) and bool(p.props.can_seek))
        self.m_progreso.set_range(0, max(1, largo))
        self.m_progreso.set_value(min(pos, largo or pos))
        self.m_tiempo.set_label(minutos(pos))
        self.m_total.set_label(minutos(largo) if largo else "")
        return True

    def _buscar(self, fraccion):
        self.buscando = True
        valor = fraccion * self.m_progreso.get_adjustment().get_upper()
        self.m_progreso.set_value(valor)
        self.m_tiempo.set_label(minutos(valor))

    def _buscar_fin(self, valor=None):
        p = self._actual()
        if p and self.m_progreso.get_sensitive():
            v = self.m_progreso.get_value() if valor is None else valor
            try:
                p.set_position(int(v))
            except GLib.Error as e:
                log(f"posición: {e.message}")
        self.buscando = False

    # volumen general (PipeWire)

    def _leer_volumen(self):
        try:
            r = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
                               capture_output=True, text=True, timeout=1)
            partes = r.stdout.split()           # "Volume: 0.25 [MUTED]"
            nivel = float(partes[1])
            silencio = "[MUTED]" in partes
        except (OSError, subprocess.SubprocessError, IndexError, ValueError):
            nivel, silencio = 0.5, False
        self.leyendo_volumen = True
        self.m_volumen.set_value(round(min(nivel, 1.0) * 100))
        self.leyendo_volumen = False
        self.silencio = silencio
        self._icono_volumen()

    def _volumen_cambiado(self, escala):
        nivel = round(escala.get_value())
        self.m_vol_pct.set_label(f"{nivel}%")
        self._icono_volumen()
        if self.leyendo_volumen:
            return
        self.volumen_pendiente = nivel
        if not self.espera_volumen:
            self.espera_volumen = GLib.timeout_add(60, self._aplicar_volumen)

    def _aplicar_volumen(self):
        self.espera_volumen = 0
        try:
            Gio.Subprocess.new(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@",
                                f"{self.volumen_pendiente / 100:.2f}"],
                               Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error as e:
            log(f"volumen: {e.message}")
        return False

    def _alternar_silencio(self):
        try:
            Gio.Subprocess.new(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"],
                               Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error as e:
            log(f"silencio: {e.message}")
            return
        self.silencio = not self.silencio
        self._icono_volumen()

    def _icono_volumen(self):
        v = self.m_volumen.get_value()
        nombre = ("muted" if self.silencio or v == 0 else
                  "low" if v < 34 else "medium" if v < 67 else "high")
        self.m_silencio.set_icon_name(f"audio-volume-{nombre}-symbolic")

