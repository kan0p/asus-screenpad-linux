                             else ["fondo-imagen"])
        fondo.add_named(imagen, "image")
        self.fondos.append((fondo, imagen))
        return fondo

    def _aplicar_fondo(self):
        c = self.conf
        try:
            blur = max(0, min(60, int(c["background_blur"])))
        except (TypeError, ValueError):
            blur = 12
        fondo = color(c["background_color"]).to_string()
        try:
            atenuar = max(0, min(80, int(c["background_dim"]))) / 100
        except (TypeError, ValueError):
            atenuar = 0
        # la imagen difuminada se agranda un poco para que el blur no deje bordes claros
        css = (f".fondo-color, .fondo-imagen {{ background: {fondo}; }}\n"
               f".difuminado {{ filter: blur({blur}px); transform: scale(1.06); }}\n"
               f".atenuar {{ background: alpha(black, {atenuar}); }}\n")
        self.css_fondo.load_from_data(css.encode())
        ruta = os.path.expanduser(str(c["background"]))
        modo = c["background_mode"]
        if modo == "image" and not os.path.isfile(ruta):
            modo = "default"
        if modo not in ("default", "color", "image"):
            modo = "default"
        for pila, imagen in self.fondos:
            if modo == "image":
                imagen.set_filename(ruta)
            else:
                imagen.set_paintable(None)
            pila.set_visible_child_name(modo)

    def _entrar_touchpad(self):
        debug("touchpad temporal")
        self._cerrar_hoja()
        self.vista.set_visible_child_name("touchpad")
        self.pad.tomar(False)
        self._programar_vuelta()

    def _volver_launcher(self):
        debug("vuelta al launcher")
        self._cancelar_vuelta()
        self.estela_w.limpiar()
        self.vista.set_visible_child_name("launcher")
        self.pad.tomar(True)

    def _en_touchpad(self):
        return (self.modo == "launcher" and self.ventana is not None
                and self.vista.get_visible_child_name() == "touchpad")

    def _programar_vuelta(self):
        self._cancelar_vuelta()
        try:
            s = float(self.conf["touchpad_return"])
        except (TypeError, ValueError):
            s = 4
        if s > 0:
            self.volver = GLib.timeout_add(int(s * 1000), self._fin_vuelta)

    def _fin_vuelta(self):
        self.volver = 0
        if self._en_touchpad():
            self._volver_launcher()
        return False

    def _cancelar_vuelta(self):
        if self.volver:
            GLib.source_remove(self.volver)
            self.volver = 0

    # llamadas desde Pad

    def al_apoyar(self):
        if self._en_touchpad():
            self._cancelar_vuelta()

    def al_soltar(self):
        if self._en_touchpad():
            self._programar_vuelta()

    def estela(self, puntos):
        if self._en_touchpad():
            self.estela_w.agregar(puntos)

    def cuatro_dedos(self):
        if self.modo != "launcher" or not self.ventana:
            return
        if self._en_touchpad():
            self._volver_launcher()
        else:
            self._entrar_touchpad()

    # ----- acciones ----------------------------------------------------------

    def _accion(self, widget, al_tocar, al_mantener=None):
        """Registra la acción del widget para el pad; con mouse los botones funcionan igual."""
        self.n_acciones += 1
        nombre = f"accion{self.n_acciones}"
        widget.set_name(nombre)
        self.acciones[nombre] = (al_tocar, al_mantener)
        if isinstance(widget, Gtk.Button):
            widget.set_focus_on_click(False)
            widget.connect("clicked", lambda _b: al_tocar())
        return widget

    def _vaciar(self, contenedor):
        """Quita los hijos y olvida sus acciones."""
        while (hijo := contenedor.get_first_child()):
            pendientes = [hijo]
            while pendientes:
                w = pendientes.pop()
                self.acciones.pop(w.get_name(), None)
                c = w.get_first_child()
                while c:
                    pendientes.append(c)
                    c = c.get_next_sibling()
            contenedor.remove(hijo)

    def accion_en(self, x, y):
        w = self.ventana.pick(x, y, Gtk.PickFlags.DEFAULT)
        while w is not None and w.get_name() not in self.acciones:
            w = w.get_parent()
        return w

    def activar(self, widget, largo=False):
        al_tocar, al_mantener = self.acciones[widget.get_name()]
        if largo:
            if al_mantener:
                al_mantener()
        else:
            al_tocar()

    def desplazar(self, x, y, dy):
        w = self.ventana.pick(x, y, Gtk.PickFlags.DEFAULT)
        while w is not None and not isinstance(w, Gtk.ScrolledWindow):
            w = w.get_parent()
        if w:
            aj = w.get_vadjustment()
            aj.set_value(aj.get_value() - dy)

    def _abrir(self, app):
        debug(f"abre {app.get_id()}")
        try:
            app.launch([], Gdk.Display.get_default().get_app_launch_context())
        except GLib.Error as e:
            log(f"no se pudo abrir {app.get_id()}: {e.message}")

    def _abrir_config(self):
        local = os.path.join(AQUI, "glasspad-config")
        cmd = local if os.access(local, os.X_OK) else "glasspad-config"
        try:
            Gio.Subprocess.new([cmd], Gio.SubprocessFlags.NONE)
        except GLib.Error as e:
            log(f"no se pudo abrir la configuración: {e.message}")

    def _ir(self, pagina):
        if self.paginas.get_visible_child_name() != pagina:
            self.paginas.set_visible_child_name(pagina)

    def _boton_centro(self):
        self._cerrar_centro()
        if self.paginas.get_visible_child_name() != "inicio":
            self._ir_inicio()
        else:
            self._cerrar_hoja()
            self._ir("apps")

    def _boton_ventanas(self):
        self._cerrar_centro()
        self._cerrar_musica()
        self._cerrar_hoja()
        if self.paginas.get_visible_child_name() == "ventanas":
            self._ir_inicio()
        else:
            self._ir("ventanas")

    def _ir_inicio(self):
        self._cerrar_hoja()
        self._cerrar_centro()
        self._cerrar_musica()
        self.paginas.set_visible_child_name("inicio")
        if self.n_paginas:
            self._ver_pagina(0, animar=self.pagina != 0)

    # ----- configuración -----------------------------------------------------

    def _vigilar_config(self):
        self.monitor_config = Gio.File.new_for_path(CONFIG).monitor_file(
            Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.monitor_config.connect("changed", self._config_cambiada)

    def _config_cambiada(self, _m, _f, _otro, evento):
        if evento in (Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED,
                      Gio.FileMonitorEvent.RENAMED, Gio.FileMonitorEvent.MOVED_IN,
                      Gio.FileMonitorEvent.DELETED):
            debug("config recargada")
            self.conf = leer_config()
            if self.ventana:
                self._aplicar_fondo()
                self._llenar_atajos()

    # ----- glasspadd ---------------------------------------------------------

    def _conectar_servicio(self):
        Gio.bus_watch_name(Gio.BusType.SESSION, BUS, Gio.BusNameWatcherFlags.NONE,
                           self._con_servicio, self._sin_servicio)

    def _con_servicio(self, bus, _nombre, _dueño):
        self.servicio = Gio.DBusProxy.new_sync(bus, Gio.DBusProxyFlags.NONE, None,
                                               BUS, RUTA, BUS, None)
        self.servicio.connect("g-signal", self._señal)
        modo = self.servicio.get_cached_property("Mode")
        self._aplicar_modo(modo.unpack() if modo else None)

    def _sin_servicio(self, *_):
        self.servicio = None
        self._aplicar_modo(None)

    def _señal(self, _proxy, _emisor, señal, params):
        if señal == "ModeChanged":
            self._aplicar_modo(params.unpack()[0])

    def _aplicar_modo(self, modo):
        debug(f"modo: {modo}")
        self.modo = modo
        self._cancelar_vuelta()
        if self.wl and modo in ("launcher", "dark", "off"):
            self._sacar_del_pad()
        elif self.wl and modo == "monitor":
            self._devolver_al_pad()
        if not self.ventana:
            self.pad.cerrar()
            return
        if modo == "launcher":
            self._ir_inicio()
            self._achicar(False)
            self.vista.set_visible_child_name("launcher")
            if self.pad.abrir():
                self.pad.tomar(True)
        else:
            self.pad.cerrar()
            self.estela_w.limpiar()
            self._achicar(True)


def main():
    app = Launcher()
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal_add(GLib.PRIORITY_DEFAULT, sig, lambda: app.quit() or False)
    app.run([a for a in sys.argv if a != "--debug"])
    app.pad.cerrar()


if __name__ == "__main__":
    main()
