    def _combo(self, titulo, subtitulo, clave, opciones):
        fila = Adw.ComboRow(title=titulo, subtitle=subtitulo or "",
                            model=Gtk.StringList.new([t for _v, t in opciones]))
        valores = [v for v, _t in opciones]
        actual = self._valor(clave)
        fila.set_selected(valores.index(actual) if actual in valores else 0)
        fila.connect("notify::selected", lambda f, _p: self._poner(clave, valores[f.get_selected()]))
        return fila

    def _interruptor(self, titulo, subtitulo, clave):
        fila = Adw.SwitchRow(title=titulo, subtitle=subtitulo, active=bool(self._valor(clave)))
        fila.connect("notify::active", lambda f, _p: self._poner(clave, f.get_active()))
        return fila

