def leer_perfiles():
    try:
        with open(ATAJOS_TOML, "rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as e:
        print(f"glasspad-config: sin perfiles de Quick Key ({ATAJOS_TOML}): {e}", file=sys.stderr)
        return {"general": {"nombre": "Generales", "atajos": []}}


def clave_app(app):
    """El app_id con que una app aparece como ventana: StartupWMClass o el id del .desktop."""
    clase = app.get_startup_wm_class() if hasattr(app, "get_startup_wm_class") else None
    return clase or (app.get_id() or "").removesuffix(".desktop")


def combinacion_legible(texto):
    """'ctrl+shift+z' -> 'Ctrl+Shift+Z'."""
    partes = str(texto).split("+")
    return "+".join(p.upper() if len(p) == 1 else p[:1].upper() + p[1:] for p in partes)


def leer():
    try:
        with open(CONFIG, "rb") as f:
            return tomllib.load(f)
    except FileNotFoundError:
        return {}
    except (tomllib.TOMLDecodeError, OSError) as e:
        print(f"glasspad-config: config ilegible ({CONFIG}): {e}", file=sys.stderr)
        return {}


def a_toml(valor):
    if isinstance(valor, bool):
        return "true" if valor else "false"
    if isinstance(valor, (int, float)):
        return str(valor)
    if isinstance(valor, list):
        return "[" + ", ".join(a_toml(v) for v in valor) + "]"
    texto = str(valor).replace("\\", "\\\\").replace('"', '\\"')
    return f'"{texto}"'


def guardar(conf):
    """Escribe claves simples (texto, números, booleanos y listas) y tablas de un nivel
    con subtablas, como [quick_key_apps."brave-browser"]."""
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    lineas = ["# escrito por glasspad-config; se puede editar a mano"]
    lineas += [f"{k} = {a_toml(v)}" for k, v in conf.items() if not isinstance(v, dict)]
    for k, tabla in conf.items():
        if not isinstance(tabla, dict):
            continue
        for sub, valores in tabla.items():
            if isinstance(valores, dict):
                lineas.append(f"\n[{k}.{a_toml(sub)}]")
                lineas += [f"{kk} = {a_toml(vv)}" for kk, vv in valores.items()]
    tmp = CONFIG + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(lineas) + "\n")
    os.replace(tmp, CONFIG)


class Ventana(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="GlassPad Configurator", default_width=880,
                         default_height=920)
        self.conf = leer()
        self.listo = False

        pestanas = Adw.ViewStack()
        for nombre, titulo, icono, grupos in (
                ("apariencia", "Apariencia", "preferences-desktop-wallpaper-symbolic",
                 (self._grupo_fondo,)),
                ("screenpad", "ScreenPad", "input-touchpad-symbolic",
                 (self._grupo_modos, self._grupo_atenuar, self._grupo_bateria,
                  self._grupo_touchpad)),
                ("quickkey", "Quick Key", "input-keyboard-symbolic",
                 (self._grupo_perfil, self._grupo_atajos)),
                ("portapapeles", "Portapapeles", "edit-paste-symbolic",
                 (self._grupo_portapapeles, self._grupo_panel))):
            pagina = Adw.PreferencesPage()
            for grupo in grupos:
                pagina.add(grupo())
            pestanas.add_titled_with_icon(pagina, nombre, titulo, icono)
        cabecera = Adw.HeaderBar(title_widget=Adw.ViewSwitcher(
            stack=pestanas, policy=Adw.ViewSwitcherPolicy.WIDE))
        menu = Gio.Menu()
        menu.append("Acerca de GlassPad", "app.acerca")
        cabecera.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu,
                                         tooltip_text="Menú principal"))

        vista = Adw.ToolbarView(content=pestanas)
        vista.add_top_bar(cabecera)
        self.set_content(vista)
        self._mostrar_filas()
        self.listo = True

