    @staticmethod
    def _leer_atajos_cosmic():
        try:
            with open(ATAJOS_COSMIC) as f:
                return f.read()
        except OSError:
            return ""

    def _mostrar_super_v(self):
        texto = self._leer_atajos_cosmic()
        if 'Spawn("glasspad clipboard")' in texto:
            self.fila_super_v.set_subtitle("Configurado en los atajos de COSMIC")
            self.boton_super_v.set_label("Quitar")
            self.boton_super_v.remove_css_class("suggested-action")
        else:
            self.fila_super_v.set_subtitle("Agrega el atajo a COSMIC")
            self.boton_super_v.set_label("Configurar")
            self.boton_super_v.add_css_class("suggested-action")

    def _alternar_super_v(self, _b):
        texto = self._leer_atajos_cosmic()
        if 'Spawn("glasspad clipboard")' in texto:
            lineas = [l for l in texto.splitlines(keepends=True)
                      if 'Spawn("glasspad clipboard")' not in l]
            nuevo = "".join(lineas)
        elif re.search(r'modifiers:\s*\[\s*Super\s*,?\s*\],\s*key:\s*"v"', texto):
            self.fila_super_v.set_subtitle("Super+V ya tiene otro atajo en COSMIC; quítalo primero")
            return
        elif texto.strip().endswith("}"):
            cuerpo = texto.rstrip()[:-1].rstrip()
            separador = "" if cuerpo.endswith(",") or cuerpo.endswith("{") else ","
            nuevo = f"{cuerpo}{separador}\n{ENTRADA_SUPER_V}}}\n"
        else:
            nuevo = "{\n" + ENTRADA_SUPER_V + "}\n"
        try:
            os.makedirs(os.path.dirname(ATAJOS_COSMIC), exist_ok=True)
            tmp = ATAJOS_COSMIC + ".tmp"
            with open(tmp, "w") as f:
                f.write(nuevo)
            os.replace(tmp, ATAJOS_COSMIC)
        except OSError as e:
            self.fila_super_v.set_subtitle(f"No se pudo guardar: {e.strerror}")
            return
        self._mostrar_super_v()

    def _borrar_historial(self):
        try:
            Gio.bus_get_sync(Gio.BusType.SESSION).call_sync(
                "io.github.kan0p.GlassPad", "/io/github/kan0p/GlassPad", "io.github.kan0p.GlassPad",
                "ClipboardClear", None, None, Gio.DBusCallFlags.NONE, 1000, None)
        except GLib.Error as e:
            print(f"glasspad-config: {e.message}", file=sys.stderr)

    # ----- Quick Key ---------------------------------------------------------

    def _grupo_perfil(self):
        self.perfiles = leer_perfiles()
        g = Adw.PreferencesGroup(
            title="Perfil",
            description="Quick Key muestra los atajos de la app activa; si no tiene, los generales.")
        self.claves_perfil = [""]
        nombres = ["Generales"]
        conocidas = {a.lower() for p in self.perfiles.values() for a in p.get("apps", [])}
        propias = set(self._propios())
        for app in sorted(Gio.AppInfo.get_all(), key=lambda a: a.get_display_name().casefold()):
            if not app.should_show():
                continue
            clave = self._clave_conocida(app, conocidas | {k.lower() for k in propias})
            if clave and clave not in self.claves_perfil:
                self.claves_perfil.append(clave)
                nombres.append(app.get_display_name())
        self.selector = Adw.ComboRow(title="Atajos para", model=Gtk.StringList.new(nombres))
        self.selector.connect("notify::selected", lambda f, _p: self._ver_perfil(
            self.claves_perfil[f.get_selected()]))
        g.add(self.selector)
        otra = Adw.ButtonRow(title="Otra app…", start_icon_name="list-add-symbolic")
        otra.connect("activated", lambda _f: DialogoApp(self._app_elegida).present(self))
        g.add(otra)
        return g

    def _clave_conocida(self, app, conocidas):
        """La clave de perfil de una app instalada si alguna de sus variantes es conocida."""
        posibles = [clave_app(app), (app.get_id() or "").removesuffix(".desktop")]
        for p in posibles:
            for c in self.perfiles.values():
                for a in c.get("apps", []):
                    if a.lower() == p.lower():
                        return a
            for k in self._propios():
                if k.lower() == p.lower():
                    return k
        return None

    def _propios(self):
        propios = self.conf.get("quick_key_apps")
        return propios if isinstance(propios, dict) else {}

    def _app_elegida(self, app):
        clave = self._clave_conocida(app, set()) or clave_app(app)
        if clave not in self.claves_perfil:
            self.claves_perfil.append(clave)
            self.selector.get_model().append(app.get_display_name())
        self.selector.set_selected(self.claves_perfil.index(clave))

    def _grupo_atajos(self):
        self.grupo_atajos = Adw.PreferencesGroup(title="Atajos")
        restablecer = Gtk.Button(label="Restablecer", valign=Gtk.Align.CENTER,
                                 css_classes=["flat"])
        restablecer.connect("clicked", lambda _b: self._guardar_atajos(None))
        self.grupo_atajos.set_header_suffix(restablecer)
        self.filas_atajos = []
        self._ver_perfil("")
        return self.grupo_atajos

    def _origen(self, clave):
        """(atajos, descripción) del perfil: propio, predeterminado por tipo o generales."""
        if clave:
            propio = self._propios().get(clave)
            if isinstance(propio, dict) and propio.get("atajos"):
                return propio["atajos"], "Perfil propio de esta app."
            for p in self.perfiles.values():
                if clave.lower() in (a.lower() for a in p.get("apps", [])):
                    return p["atajos"], f"Predeterminados de {p['nombre']}; al editarlos se crea un perfil propio."
            return self._generales(), "Usa los generales; al editarlos se crea un perfil propio."
        return self._generales(), f"Para cualquier app sin perfil; hasta {MAX_ATAJOS}."

    def _generales(self):
        propios = self.conf.get("quick_keys")
        if isinstance(propios, list) and propios:
            return propios
        return self.perfiles.get("general", {}).get("atajos", [])

    def _ver_perfil(self, clave):
        self.perfil = clave
        atajos, descripcion = self._origen(clave)
        self.atajos = [list(a) for a in atajos]
        self.grupo_atajos.set_description(descripcion)
        self._llenar_atajos()

    def _llenar_atajos(self):
        for fila in self.filas_atajos:
            self.grupo_atajos.remove(fila)
        self.filas_atajos = []
        for i, (texto, icono, combinacion) in enumerate(self.atajos):
            fila = Adw.ActionRow(title=texto, subtitle=combinacion_legible(combinacion))
            fila.add_prefix(Gtk.Image.new_from_icon_name(icono or "input-keyboard-symbolic"))
            for nombre, ayuda, accion, activo in (
                    ("go-up-symbolic", "Subir", lambda _b, i=i: self._mover_atajo(i, -1), i > 0),
                    ("go-down-symbolic", "Bajar", lambda _b, i=i: self._mover_atajo(i, 1),
                     i < len(self.atajos) - 1),
                    ("document-edit-symbolic", "Editar", lambda _b, i=i: self._editar_atajo(i), True),
                    ("user-trash-symbolic", "Quitar", lambda _b, i=i: self._quitar_atajo(i), True)):
                b = Gtk.Button(icon_name=nombre, tooltip_text=ayuda, valign=Gtk.Align.CENTER,
                               css_classes=["flat"], sensitive=activo)
                b.connect("clicked", accion)
                fila.add_suffix(b)
            self.grupo_atajos.add(fila)
            self.filas_atajos.append(fila)
        if len(self.atajos) < MAX_ATAJOS:
            agregar = Adw.ButtonRow(title="Agregar atajo", start_icon_name="list-add-symbolic")
            agregar.connect("activated", lambda _f: self._editar_atajo(None))
            self.grupo_atajos.add(agregar)
            self.filas_atajos.append(agregar)

    def _guardar_atajos(self, atajos):
        """None vuelve al perfil predeterminado (sin el propio)."""
        if self.perfil:
            propios = dict(self._propios())
            if atajos is None:
                propios.pop(self.perfil, None)
            else:
                propios[self.perfil] = {"atajos": [list(a) for a in atajos]}
            self.conf["quick_key_apps"] = propios
            if not propios:
                self.conf.pop("quick_key_apps")
            self._poner_todo()
        elif atajos is None:
            self.conf.pop("quick_keys", None)
            self._poner_todo()
        else:
            self._poner("quick_keys", [list(a) for a in atajos])
        self._ver_perfil(self.perfil)

    def _mover_atajo(self, i, paso):
        a = list(self.atajos)
        a.insert(i + paso, a.pop(i))
        self._guardar_atajos(a)

    def _quitar_atajo(self, i):
        self._guardar_atajos(self.atajos[:i] + self.atajos[i + 1:])

    def _editar_atajo(self, i):
        actual = self.atajos[i] if i is not None else ["", "input-keyboard-symbolic", ""]
        DialogoAtajo(actual, lambda nuevo: self._atajo_editado(i, nuevo)).present(self)

    def _atajo_editado(self, i, nuevo):
        a = list(self.atajos)
        if i is None:
            a.append(nuevo)
        else:
            a[i] = nuevo
        self._guardar_atajos(a)

    def _poner_todo(self):
        try:
            guardar(self.conf)
        except OSError as e:
            print(f"glasspad-config: no se pudo guardar: {e}", file=sys.stderr)

    def _entero(self, clave):
        try:
            return int(self._valor(clave))
        except (TypeError, ValueError):
            return PREDETERMINADA[clave]

    def _mostrar_filas(self):
        tipo = TIPOS[self.tipo.get_selected()]
        self.fila_color.set_visible(tipo == "color")
        self.fila_imagen.set_visible(tipo == "image")
        self.fila_blur.set_visible(tipo == "image")

    def _mostrar_ruta(self):
        ruta = str(self._valor("background"))
        self.fila_imagen.set_subtitle(os.path.basename(ruta) if ruta else "sin imagen")

    def _poner(self, clave, valor):
        if not self.listo:
            return
        self.conf[clave] = valor
        try:
            guardar(self.conf)
        except OSError as e:
            print(f"glasspad-config: no se pudo guardar: {e}", file=sys.stderr)

    def _cambio_tipo(self, fila, _p):
        self._mostrar_filas()
        self._poner("background_mode", TIPOS[fila.get_selected()])

    def _cambio_color(self, boton, _p):
        c = boton.get_rgba()
        self._poner("background_color", "#{:02x}{:02x}{:02x}".format(
            round(c.red * 255), round(c.green * 255), round(c.blue * 255)))

    def _elegir_imagen(self, _b):
        filtro = Gtk.FileFilter(name="Imágenes")
        filtro.add_mime_type("image/*")
        filtros = Gio.ListStore.new(Gtk.FileFilter)
        filtros.append(filtro)
        dialogo = Gtk.FileDialog(title="Imagen de fondo", filters=filtros)
        dialogo.open(self, None, self._imagen_elegida)

    def _imagen_elegida(self, dialogo, res):
        try:
            archivo = dialogo.open_finish(res)
        except GLib.Error:
            return                  # cancelado
        if archivo and archivo.get_path():
            self._poner("background", archivo.get_path())
            self._mostrar_ruta()


class DialogoAtajo(Adw.Dialog):
    """Nombre, ícono y combinación de un atajo. La combinación se graba presionándola."""

    def __init__(self, atajo, al_guardar):
        super().__init__(title="Atajo", content_width=460)
        texto, icono, combinacion = atajo
        self.al_guardar = al_guardar
        if icono and icono not in ICONOS_ATAJO:
            ICONOS_ATAJO.append(icono)
        self.icono = icono if icono in ICONOS_ATAJO else ICONOS_ATAJO[0]
        self.combinacion = combinacion
        self.grabando = False

        self.guardar_b = Gtk.Button(label="Guardar", css_classes=["suggested-action"])
        self.guardar_b.connect("clicked", self._guardar)
        cabecera = Adw.HeaderBar()
        cabecera.pack_end(self.guardar_b)

        datos = Adw.PreferencesGroup()
        self.nombre = Adw.EntryRow(title="Nombre", text=texto)
        self.nombre.connect("changed", lambda _e: self._validar())
        datos.add(self.nombre)
        self.fila_comb = Adw.ActionRow(title="Combinación")
        self.grabar_b = Gtk.Button(label="Grabar", valign=Gtk.Align.CENTER)
        self.grabar_b.connect("clicked", self._grabar)
        self.fila_comb.add_suffix(self.grabar_b)
        datos.add(self.fila_comb)

        iconos = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.SINGLE, max_children_per_line=7,
                             min_children_per_line=7, homogeneous=True, row_spacing=6,
                             column_spacing=6)
        for nombre in ICONOS_ATAJO:
            img = Gtk.Image.new_from_icon_name(nombre)
            img.set_pixel_size(24)
            img.set_margin_top(8)
            img.set_margin_bottom(8)
            iconos.append(img)
            if nombre == self.icono:
                iconos.select_child(iconos.get_child_at_index(ICONOS_ATAJO.index(nombre)))
        iconos.connect("selected-children-changed", self._icono_elegido)
        grupo_iconos = Adw.PreferencesGroup(title="Ícono")
        grupo_iconos.add(iconos)

        pagina = Adw.PreferencesPage()
        pagina.add(datos)
        pagina.add(grupo_iconos)
        vista = Adw.ToolbarView(content=pagina)
        vista.add_top_bar(cabecera)
        self.set_child(vista)

        teclas = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        teclas.connect("key-pressed", self._tecla)
        self.add_controller(teclas)
        self._mostrar_combinacion()

    def _mostrar_combinacion(self):
        if self.grabando:
            self.fila_comb.set_subtitle("Presiona la combinación…")
        else:
            self.fila_comb.set_subtitle(combinacion_legible(self.combinacion)
                                        if self.combinacion else "sin combinación")
        self._validar()

    def _validar(self):
        self.guardar_b.set_sensitive(bool(self.nombre.get_text().strip())
                                     and bool(self.combinacion) and not self.grabando)

    def _grabar(self, _b):
        self.grabando = True
        self.grabar_b.set_sensitive(False)
        self._mostrar_combinacion()

    def _tecla(self, _c, keyval, _keycode, estado):
        if not self.grabando:
            return False
        if keyval in TECLAS_MODIFICADORAS:
            return True
        mods = [nombre for mascara, nombre in MODIFICADORES if estado & mascara]
        tecla = Gdk.keyval_name(Gdk.keyval_to_lower(keyval))
        if not tecla:
            return True
        self.combinacion = "+".join(mods + [tecla])
        self.grabando = False
        self.grabar_b.set_sensitive(True)
        self._mostrar_combinacion()
        return True

    def _icono_elegido(self, caja):
        elegidos = caja.get_selected_children()
        if elegidos:
            self.icono = ICONOS_ATAJO[elegidos[0].get_index()]

    def _guardar(self, _b):
        self.al_guardar([self.nombre.get_text().strip(), self.icono, self.combinacion])
        self.close()


class DialogoApp(Adw.Dialog):
    """Lista buscable de apps instaladas para crear un perfil de Quick Key."""

    def __init__(self, al_elegir):
        super().__init__(title="Elegir app", content_width=440, content_height=560)
        self.al_elegir = al_elegir
        self.busqueda = Gtk.SearchEntry(placeholder_text="Buscar app", margin_start=12,
                                        margin_end=12, margin_top=6, margin_bottom=6)
        self.lista = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE,
                                 css_classes=["boxed-list"], margin_start=12, margin_end=12,
                                 margin_bottom=12)
        self.apps = sorted((a for a in Gio.AppInfo.get_all() if a.should_show()),
                           key=lambda a: a.get_display_name().casefold())
        for app in self.apps:
            fila = Adw.ActionRow(title=app.get_display_name(), activatable=True)
            icono = Gtk.Image.new_from_gicon(app.get_icon() or Gio.ThemedIcon.new(
                "application-x-executable"))
            icono.set_pixel_size(32)
            fila.add_prefix(icono)
            fila.connect("activated", lambda _f, a=app: self._elegir(a))
            self.lista.append(fila)
        self.lista.set_filter_func(self._filtro)
        self.busqueda.connect("search-changed", lambda _b: self.lista.invalidate_filter())
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        caja.append(self.busqueda)
        caja.append(Gtk.ScrolledWindow(child=self.lista, vexpand=True,
                                       hscrollbar_policy=Gtk.PolicyType.NEVER))
        vista = Adw.ToolbarView(content=caja)
        vista.add_top_bar(Adw.HeaderBar())
        self.set_child(vista)

    def _filtro(self, fila):
        texto = self.busqueda.get_text().casefold()
        return not texto or texto in fila.get_child().get_title().casefold() \
            if hasattr(fila.get_child(), "get_title") else True

    def _elegir(self, app):
        self.al_elegir(app)
        self.close()


