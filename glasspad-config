        fila = Adw.SpinRow.new_with_range(minimo, maximo, paso)
        fila.set_title(titulo)
        if subtitulo:
            fila.set_subtitle(subtitulo)
        fila.set_value(self._entero(clave))
        fila.connect("notify::value", lambda f, _p: self._poner(clave, int(f.get_value())))
        return fila

