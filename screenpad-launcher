class Pad:
    """Lee el pad: toques, toque largo y arrastre cuando está tomado; estela y cuatro
    dedos siempre."""

    def __init__(self, launcher):
        self.launcher = launcher
        self.dev = None
        self.fuente = 0
        self.tomado = False
        self.max_x = self.max_y = 1
        self.x = self.y = 0
        self.slot = 0
        self.dedos = {}             # slot -> [x, y] en unidades del pad
        self.tocando = False
        self.t_apoyo = None         # cuándo empezó el toque actual
        self.max_dedos = 0
        self.inicio = None          # (x, y) lógicos del toque de un dedo
        self.ultimo = None
        self.movido = False
        self.objetivo = None        # widget con acción bajo el dedo
        self.largo = 0              # timeout del toque largo
        self.arrastre = None        # (mover, soltar) mientras se arrastra algo

    def abrir(self):
        if self.dev:
            return True
        try:
            dev = buscar_pad(self.launcher.conf["pad_device"])
        except PermissionError:
            dev = None
        if dev is None:
            log(f"no se pudo abrir '{self.launcher.conf['pad_device']}'")
            return False
        abs_ = dict(dev.capabilities(absinfo=True).get(ecodes.EV_ABS, []))
        self.max_x = abs_[ecodes.ABS_X].max if ecodes.ABS_X in abs_ else 3840
        self.max_y = abs_[ecodes.ABS_Y].max if ecodes.ABS_Y in abs_ else 2160
        self.dev = dev
        self.fuente = GLib.io_add_watch(dev.fd, GLib.PRIORITY_DEFAULT,
                                        GLib.IO_IN | GLib.IO_ERR | GLib.IO_HUP, self._leer)
        debug(f"pad abierto: {dev.path} ({self.max_x}x{self.max_y})")
        return True

    def cerrar(self):
        if not self.dev:
            return
        if self.fuente:
            GLib.source_remove(self.fuente)
            self.fuente = 0
        try:
            self.dev.close()        # cerrar libera el grab
        except OSError:
            pass
        self.dev = None
        self.tomado = False
        self._reiniciar()
        debug("pad cerrado")

    def tomar(self, si):
        """Toma el pad en exclusiva (launcher) o lo deja libre (touchpad temporal)."""
        if not self.dev or self.tomado == si:
            return
        try:
            self.dev.grab() if si else self.dev.ungrab()
            self.tomado = si
            debug("pad tomado" if si else "pad libre")
        except OSError as e:
            log(f"no se pudo {'tomar' if si else 'liberar'} el pad: {e}")

    def _leer(self, _fd, _cond):
        try:
            for ev in self.dev.read():
                self._evento(ev)
        except BlockingIOError:
            pass
        except OSError as e:
            log(f"se perdió el pad: {e}")
            self.fuente = 0
            self.cerrar()
            return False
        return True

    def _evento(self, ev):
        if ev.type == ecodes.EV_ABS:
            c, v = ev.code, ev.value
            if c == ecodes.ABS_X:
                self.x = v
            elif c == ecodes.ABS_Y:
                self.y = v
            elif c == ecodes.ABS_MT_SLOT:
                self.slot = v
            elif c == ecodes.ABS_MT_TRACKING_ID:
                if v < 0:
                    self.dedos.pop(self.slot, None)
                else:
                    self.dedos[self.slot] = [self.x, self.y]
            elif c == ecodes.ABS_MT_POSITION_X and self.slot in self.dedos:
                self.dedos[self.slot][0] = v
            elif c == ecodes.ABS_MT_POSITION_Y and self.slot in self.dedos:
                self.dedos[self.slot][1] = v
        elif ev.type == ecodes.EV_KEY:
            if ev.code == ecodes.BTN_TOUCH:
                self.tocando = ev.value == 1
                if not self.tocando:
                    self._soltado()
            elif ev.code == ecodes.BTN_TOOL_QUADTAP and ev.value:
                self.max_dedos = max(self.max_dedos, 4)
            elif ev.code == ecodes.BTN_TOOL_QUINTTAP and ev.value:
                self.max_dedos = max(self.max_dedos, 5)
        elif ev.type == ecodes.EV_SYN and self.tocando:
            self._cuadro()

    def _a_ventana(self, x, y):
        w = self.launcher.ventana
        return (x / self.max_x * w.get_width(), y / self.max_y * w.get_height())

    def _cuadro(self):
        """Un cuadro completo del pad con al menos un dedo apoyado."""
        self.max_dedos = max(self.max_dedos, len(self.dedos), 1)
        if self.t_apoyo is None:
            self.t_apoyo = time.monotonic()
            self.launcher.al_apoyar()
        if not self.tomado:
            self.launcher.estela([(s, *self._a_ventana(*p)) for s, p in self.dedos.items()])
            return
        if self.max_dedos > 1:
            self._sin_objetivo()
            return
        pos = self._a_ventana(self.x, self.y)
        if self.inicio is None:
            self._apoyado(pos)
        else:
            self._movido(pos)

    def _apoyado(self, pos):
        self.inicio = self.ultimo = pos
        self.movido = False
        self.objetivo = self.launcher.accion_en(*pos)
        if self.objetivo:
            self.objetivo.add_css_class("presionado")
            self.largo = GLib.timeout_add(TOQUE_LARGO_MS, self._toque_largo)

    def arrastrar(self, mover, soltar):
        """Desde un toque largo: el resto del toque mueve y suelta lo arrastrado."""
        self.arrastre = (mover, soltar)

    def _movido(self, pos):
        if self.arrastre:
            self.ultimo = pos
            self.arrastre[0](pos)
            return
        if not self.movido and (abs(pos[0] - self.inicio[0]) > TOQUE_MOVER
                                or abs(pos[1] - self.inicio[1]) > TOQUE_MOVER):
            self.movido = True
            self._sin_objetivo()
        if self.movido:
            self.launcher.desplazar(*self.inicio, pos[1] - self.ultimo[1])
        self.ultimo = pos

    def _soltado(self):
        if self.arrastre:
            soltar, self.arrastre = self.arrastre[1], None
            soltar(self.ultimo)
            self._reiniciar()
            return
        duracion = time.monotonic() - self.t_apoyo if self.t_apoyo else 0
        if self.max_dedos >= 4 and duracion < CUATRO_DEDOS_S:
            debug("cuatro dedos")
            self._reiniciar()
            self.launcher.cuatro_dedos()
            return
        if self.tomado and self.objetivo and not self.movido and self.max_dedos == 1:
            debug(f"toque en {self.objetivo.get_name()}")
            self.launcher.activar(self.objetivo)
        elif self.tomado and self.movido and self.max_dedos == 1 and self.inicio and self.ultimo:
            dx = self.ultimo[0] - self.inicio[0]
            dy = self.ultimo[1] - self.inicio[1]
            if abs(dx) > DESLIZAR and abs(dx) > 2 * abs(dy):
                self.launcher.deslizar(1 if dx < 0 else -1)
        self._reiniciar()
        self.launcher.al_soltar()

    def _toque_largo(self):
        self.largo = 0
        if self.objetivo:
            debug(f"toque largo en {self.objetivo.get_name()}")
            self.launcher.activar(self.objetivo, largo=True)
        self._sin_objetivo()
        self.movido = True          # al soltar no cuenta como toque
        return False

    def _sin_objetivo(self):
        if self.largo:
            GLib.source_remove(self.largo)
            self.largo = 0
        if self.objetivo:
            self.objetivo.remove_css_class("presionado")
            self.objetivo = None

    def _reiniciar(self):
        if self.arrastre:
            soltar, self.arrastre = self.arrastre[1], None
            soltar(None)            # cancelado
        self._sin_objetivo()
        self.inicio = self.ultimo = self.t_apoyo = None
        self.movido = False
        self.max_dedos = 0


class Estela(Gtk.Widget):
    """Dibuja por dónde pasan los dedos; cada punto se desvanece en ESTELA_S."""

    def __init__(self):
        super().__init__(can_target=False, hexpand=True, vexpand=True)
        self.trazos = {}            # slot -> [(x, y, t)]
        self.tic = 0

    def agregar(self, puntos):
        ahora = time.monotonic()
        for slot, x, y in puntos:
            self.trazos.setdefault(slot, []).append((x, y, ahora))
        if not self.tic:
            self.tic = self.add_tick_callback(self._tic)

    def limpiar(self):
        self.trazos.clear()
        self.queue_draw()

    def _tic(self, _w, _reloj):
        limite = time.monotonic() - ESTELA_S
        for slot in list(self.trazos):
            self.trazos[slot] = [p for p in self.trazos[slot] if p[2] > limite]
            if not self.trazos[slot]:
                del self.trazos[slot]
        self.queue_draw()
        if not self.trazos:
            self.tic = 0
            return False
        return True

    def do_snapshot(self, snap):
        ahora = time.monotonic()
        for puntos in self.trazos.values():
            for (x0, y0, _), (x1, y1, t) in zip([puntos[0], *puntos], puntos):
                vida = max(0.0, 1 - (ahora - t) / ESTELA_S)
                b = Gsk.PathBuilder.new()
                b.move_to(x0, y0)
                b.line_to(x1, y1)
                trazo = Gsk.Stroke.new(4 + 10 * vida)
                trazo.set_line_cap(Gsk.LineCap.ROUND)
                c = Gdk.RGBA()
                c.red = c.green = c.blue = 1.0
                c.alpha = 0.55 * vida
                snap.append_stroke(b.to_path(), trazo, c)


class Launcher(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.conf = leer_config()
        self.ventana = None
        self.acciones = {}          # nombre del widget -> (al tocar, al mantener)
        self.n_acciones = 0
        self.n_paginas = 0
        self.fondos = []            # (Gtk.Stack, Gtk.Picture) de cada fondo
        self.mosaico_id = {}        # nombre del mosaico del inicio -> id de la app
        self.orden = None           # ids del inicio mientras se arrastra
        self.arrastrada = None
        self.espera_borde = 0
        self.pad = Pad(self)
        self.servicio = None
        self.modo = None
        self.volver = 0             # timeout de vuelta desde el touchpad temporal
        self.espera_salida = 0
        self.css_fondo = Gtk.CssProvider()

    def do_activate(self):
        if self.ventana:
            return
        self.hold()
        pantalla = Gdk.Display.get_default()
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(pantalla, prov,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gtk.StyleContext.add_provider_for_display(pantalla, self.css_fondo,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        self._vigilar_config()
        self._conectar_servicio()
        pantalla.get_monitors().connect("items-changed", lambda *_: self._revisar_salida())
        self._revisar_salida()

    def _revisar_salida(self):
        # El conector de un monitor nuevo llega después de items-changed: se mira más tarde.
        if not self.ventana and not self.espera_salida:
            self.espera_salida = GLib.timeout_add(SALIDA_ESTABLE_MS, self._salida_estable)

    def _salida_estable(self):
        self.espera_salida = 0
        salida = buscar_salida(self.conf)
        if salida is None:
            debug("sin salida del ScreenPad, se espera")
        elif not self.ventana:
            self._crear_ventana(salida)
            self._aplicar_modo(self.modo)
        return False

    # ----- ventana -----------------------------------------------------------

    def _crear_ventana(self, salida):
        v = Gtk.ApplicationWindow(application=self)
        v.add_css_class("screenpad")
        Capa.init_for_window(v)
        Capa.set_namespace(v, "screenpad-launcher")
        Capa.set_keyboard_mode(v, Capa.KeyboardMode.NONE)
        Capa.set_monitor(v, salida)
        debug(f"salida: {salida.get_connector()}")
        v.set_cursor(Gdk.Cursor.new_from_name("none", None))

        self.paginas = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                                 vexpand=True)
        self.paginas.add_named(self._pagina_inicio(), "inicio")
        self.paginas.add_named(self._pagina_apps(), "apps")
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        caja.append(self._estado())
        caja.append(self.paginas)
        caja.append(self._pie())

        launcher = Gtk.Overlay()
        launcher.set_child(self._crear_fondo(difuminado=False))
        launcher.add_overlay(Gtk.Box(css_classes=["oscurecer"], can_target=False))
        launcher.add_overlay(caja)
        self.capa_arrastre = Gtk.Fixed(can_target=False)
        launcher.add_overlay(self.capa_arrastre)
        launcher.add_overlay(self._hoja())

        self.vista = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.vista.add_named(launcher, "launcher")
        self.vista.add_named(self._touchpad(), "touchpad")
        self.vista.add_named(Gtk.Box(), "nada")
        v.set_child(self.vista)
        self.ventana = v
        self._aplicar_fondo()
        self._achicar(True)
        v.present()

    def _achicar(self, si):
        """1x1, transparente y al fondo (fuera del launcher) o el pad entero arriba."""
        v = self.ventana
        if si:
            self.vista.set_visible_child_name("nada")
            v.add_css_class("invisible")
            Capa.set_layer(v, Capa.Layer.BACKGROUND)
            Capa.set_anchor(v, Capa.Edge.TOP, True)
            Capa.set_anchor(v, Capa.Edge.LEFT, True)
            Capa.set_anchor(v, Capa.Edge.BOTTOM, False)
            Capa.set_anchor(v, Capa.Edge.RIGHT, False)
            Capa.set_exclusive_zone(v, 0)
            v.set_default_size(1, 1)
        else:
            v.remove_css_class("invisible")
            for borde in (Capa.Edge.TOP, Capa.Edge.BOTTOM, Capa.Edge.LEFT, Capa.Edge.RIGHT):
                Capa.set_anchor(v, borde, True)
            # -1: ocupa todo el pad aunque otra superficie reserve espacio
            Capa.set_exclusive_zone(v, -1)
            Capa.set_layer(v, Capa.Layer.TOP)

    def _estado(self):
        caja = Gtk.Box(css_classes=["estado"])
        self.reloj = Gtk.Label(css_classes=["reloj"], hexpand=True, xalign=0)
        self.fecha = Gtk.Label(css_classes=["fecha"], valign=Gtk.Align.BASELINE)
        caja.append(self.reloj)
        caja.append(self.fecha)
        self._tic_reloj()
        GLib.timeout_add_seconds(5, self._tic_reloj)
        return caja

    def _tic_reloj(self):
        ahora = time.localtime()
        self.reloj.set_label(time.strftime("%H:%M", ahora))
        self.fecha.set_label(f"{DIAS[ahora.tm_wday]} {ahora.tm_mday} de {MESES[ahora.tm_mon - 1]}")
        return True

    # ----- inicio ------------------------------------------------------------

    def _pagina_inicio(self):
        self.hojas_inicio = Gtk.Stack(vexpand=True, transition_duration=250)
        self.puntos = Gtk.Box(css_classes=["puntos"], spacing=15, halign=Gtk.Align.CENTER)
        self.pagina = 0
        self._llenar_inicio()
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        caja.append(self.hojas_inicio)
        caja.append(self.puntos)
        return caja

    def _llenar_inicio(self):
        self._vaciar(self.hojas_inicio)
        self.mosaico_id.clear()
        mosaicos = []
        for item_id, app in self._items_inicio():
            if app is None:
                m = self._mosaico_svg("apps", "Todas las apps", lambda: self._ir("apps"),
                                      lambda: self._arrastrar_inicio(ID_APPS, None))
            else:
                m = self._mosaico_app(app, lambda a: self._arrastrar_inicio(a.get_id(), a))
            self.mosaico_id[m.get_name()] = item_id
            if item_id == self.arrastrada:
                m.add_css_class("arrastrado")
            mosaicos.append(m)
        paginas = [mosaicos[i:i + POR_PAGINA] for i in range(0, len(mosaicos), POR_PAGINA)]
        for n, grupo in enumerate(paginas):
            grilla = Gtk.Grid(column_spacing=134, row_spacing=58, column_homogeneous=True,
                              halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
            for i, m in enumerate(grupo):
                grilla.attach(m, i % COLUMNAS, i // COLUMNAS, 1, 1)
            self.hojas_inicio.add_named(grilla, str(n))
        self.n_paginas = len(paginas)
        self._ver_pagina(min(self.pagina, self.n_paginas - 1), animar=False)

    def _items_inicio(self):
        """(id, app) de lo que se muestra en el inicio; app es None para ID_APPS."""
        items = []
        for item_id in self.orden if self.orden is not None else leer_inicio():
            if item_id == ID_APPS:
                items.append((item_id, None))
                continue
            try:
                app = DesktopAppInfo.new(item_id)
            except TypeError:
                app = None
            if app is None:
                debug(f"{item_id} no está instalada")
            else:
                items.append((item_id, app))
        return items

    def _ver_pagina(self, n, animar=True):
        if animar:
            self.hojas_inicio.set_transition_type(
                Gtk.StackTransitionType.SLIDE_LEFT if n > self.pagina
                else Gtk.StackTransitionType.SLIDE_RIGHT)
        else:
            self.hojas_inicio.set_transition_type(Gtk.StackTransitionType.NONE)
        self.pagina = n
        self.hojas_inicio.set_visible_child_name(str(n))
        self._vaciar(self.puntos)
        for i in range(self.n_paginas if self.n_paginas > 1 else 0):
            self.puntos.append(Gtk.Box(css_classes=["punto", "activo"] if i == n else ["punto"],
                                       valign=Gtk.Align.CENTER))

    def deslizar(self, hacia):
        """Pasa de página en el inicio: hacia = 1 (siguiente) o -1 (anterior)."""
        if self.paginas.get_visible_child_name() != "inicio":
            return
        n = self.pagina + hacia
        if 0 <= n < self.n_paginas:
            self._ver_pagina(n)

    def _mosaico_app(self, app, al_mantener):
        img = Gtk.Image.new_from_gicon(app.get_icon() or Gio.ThemedIcon.new("application-x-executable"))
        return self._mosaico(img, app.get_display_name(), lambda: self._abrir(app),
                             lambda: al_mantener(app))

    def _mosaico_svg(self, nombre, texto, al_tocar, al_mantener=None):
        img = Gtk.Image.new_from_file(os.path.join(ICONOS, "tiles", nombre + ".svg"))
        return self._mosaico(img, texto, al_tocar, al_mantener)

    def _mosaico(self, img, texto, al_tocar, al_mantener=None):
        img.add_css_class("icono")
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=19)
        caja.append(img)
        caja.append(Gtk.Label(label=texto, max_width_chars=14, ellipsize=3,
                              justify=Gtk.Justification.CENTER))
        return self._accion(Gtk.Button(child=caja, css_classes=["mosaico"]),
                            al_tocar, al_mantener)

    # ----- todas las apps ----------------------------------------------------

    def _pagina_apps(self):
        self.lista_apps = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE,
                                      homogeneous=True, min_children_per_line=6,
                                      max_children_per_line=6, row_spacing=40,
                                      column_spacing=24, valign=Gtk.Align.START,
                                      css_classes=["lista"])
        self._llenar_apps()
        Gio.AppInfoMonitor.get().connect("changed", lambda _m: self._llenar_apps())
        desplazable = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER,
                                         vexpand=True, child=self.lista_apps)
        caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        caja.append(Gtk.Label(label="Todas las apps", xalign=0, css_classes=["titulo"]))
        caja.append(desplazable)
        return caja

    def _llenar_apps(self):
        self._vaciar(self.lista_apps)
        apps = sorted((a for a in Gio.AppInfo.get_all() if a.should_show()),
                      key=lambda a: a.get_display_name().casefold())
        for app in apps:
            self.lista_apps.append(self._mosaico_app(app, self._menu_apps))

    # ----- menú de toque largo -----------------------------------------------

    def _hoja(self):
        self.velo = Gtk.Box(css_classes=["velo"], visible=False)
        self._accion(self.velo, self._cerrar_hoja)
        tarjeta = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, css_classes=["hoja"],
                          halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, hexpand=True)
        self.hoja_nombre = Gtk.Label(css_classes=["nombre"])
        self.hoja_boton = Gtk.Button(css_classes=["principal"])
        self._accion(self.hoja_boton, self._hoja_aceptar)
        tarjeta.append(self.hoja_nombre)
        tarjeta.append(self.hoja_boton)
        tarjeta.append(self._accion(Gtk.Button(label="Cancelar"), self._cerrar_hoja))
        self.velo.append(tarjeta)
        self.hoja_accion = None
        return self.velo

    def _mostrar_hoja(self, app, texto, accion):
        self.hoja_nombre.set_label(app.get_display_name())
        self.hoja_boton.set_label(texto)
        self.hoja_accion = accion
        self.velo.set_visible(True)

    def _hoja_aceptar(self):
        accion, self.hoja_accion = self.hoja_accion, None
        self._cerrar_hoja()
        if accion:
            accion()

    def _cerrar_hoja(self):
        self.velo.set_visible(False)

    def _menu_apps(self, app):
        if app.get_id() in leer_inicio():
            self._mostrar_hoja(app, "Quitar del inicio", lambda: self._quitar_inicio(app.get_id()))
        else:
            self._mostrar_hoja(app, "Agregar al inicio", lambda: self._agregar_inicio(app.get_id()))

    def _agregar_inicio(self, app_id):
        ids = leer_inicio()
        if app_id not in ids:
            guardar_inicio(ids + [app_id])
            self._llenar_inicio()

    def _quitar_inicio(self, app_id):
        guardar_inicio([i for i in leer_inicio() if i != app_id])
        self._llenar_inicio()

    # ----- reordenar el inicio ----------------------------------------------

    def _arrastrar_inicio(self, item_id, app):
        pos = self.pad.ultimo
        if pos is None:
            return
        self.orden = [i for i, _ in self._items_inicio()]
        self.arrastrada = item_id
        if app is None:
            self.flotante = Gtk.Image.new_from_file(os.path.join(ICONOS, "tiles", "apps.svg"))
        else:
            self.flotante = Gtk.Image.new_from_gicon(
                app.get_icon() or Gio.ThemedIcon.new("application-x-executable"))
        self.flotante.add_css_class("flotante")
        self.capa_arrastre.put(self.flotante, *self._esquina_flotante(pos))
        fija = item_id == ID_APPS
        self.zona_texto.set_label("Todas las apps no se puede quitar" if fija
                                  else "Quitar del inicio")
        self.zona_icono.set_visible(not fija)
        if fija:
            self.zona.add_css_class("fija")
        else:
            self.zona.remove_css_class("fija")
        self.pie.set_visible_child_name("quitar")
        self._llenar_inicio()
        self.pad.arrastrar(self._mover_arrastre, self._soltar_arrastre)

    def _esquina_flotante(self, pos):
        return pos[0] - 88, pos[1] - 88

    def _sobre(self, pos, nombre):
        w = self.ventana.pick(*pos, Gtk.PickFlags.DEFAULT)
        while w is not None and w.get_name() != nombre:
            w = w.get_parent()
        return w is not None

    def _mosaico_en(self, pos):
        """Id de la app del inicio bajo el punto, o None."""
        w = self.ventana.pick(*pos, Gtk.PickFlags.DEFAULT)
        while w is not None and w.get_name() not in self.mosaico_id:
            w = w.get_parent()
        return self.mosaico_id[w.get_name()] if w is not None else None

    def _mover_arrastre(self, pos):
        self.capa_arrastre.move(self.flotante, *self._esquina_flotante(pos))
        if self._sobre(pos, "zona-quitar") and self.arrastrada != ID_APPS:
            self.zona.add_css_class("encima")
        else:
            self.zona.remove_css_class("encima")
        otra = self._mosaico_en(pos)
        if otra and otra != self.arrastrada:
            # toma el lugar de la otra; las de en medio se corren un puesto
            i, j = self.orden.index(self.arrastrada), self.orden.index(otra)
            self.orden.insert(j, self.orden.pop(i))
            self._llenar_inicio()
        ancho = self.ventana.get_width()
        hacia = -1 if pos[0] < BORDE_PAGINA else 1 if pos[0] > ancho - BORDE_PAGINA else 0
        if hacia and not self.espera_borde:
            self.espera_borde = GLib.timeout_add(BORDE_PAGINA_MS, self._borde, hacia)
        elif not hacia:
            self._cancelar_borde()

    def _borde(self, hacia):
        self.espera_borde = 0
        self.deslizar(hacia)
        return False

    def _cancelar_borde(self):
        if self.espera_borde:
            GLib.source_remove(self.espera_borde)
            self.espera_borde = 0

    def _soltar_arrastre(self, pos):
        self._cancelar_borde()
        self.capa_arrastre.remove(self.flotante)
        self.flotante = None
        self.zona.remove_css_class("encima")
        self.pie.set_visible_child_name("barra")
        orden, app_id = self.orden, self.arrastrada
        self.orden = self.arrastrada = None
        if pos is not None and self._sobre(pos, "zona-quitar") and app_id != ID_APPS:
            orden.remove(app_id)
            debug(f"{app_id} fuera del inicio")
        if pos is not None:
            mostradas = set(orden) | {app_id}
            guardar_inicio(orden + [i for i in leer_inicio() if i not in mostradas])
        self._llenar_inicio()

    # ----- barra -------------------------------------------------------------

    def _pie(self):
        self.pie = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.pie.add_named(self._barra(), "barra")
        self.zona = Gtk.Box(css_classes=["zona-quitar"], spacing=24,
                            halign=Gtk.Align.FILL, name="zona-quitar")
        contenido = Gtk.Box(spacing=24, halign=Gtk.Align.CENTER, hexpand=True)
        self.zona_icono = Gtk.Image.new_from_icon_name("user-trash-symbolic")
        self.zona_texto = Gtk.Label(label="Quitar del inicio")
        contenido.append(self.zona_icono)
        contenido.append(self.zona_texto)
        self.zona.append(contenido)
        self.pie.add_named(self.zona, "quitar")
        return self.pie

    def _barra(self):
        barra = Gtk.CenterBox(css_classes=["barra"])
        barra.set_start_widget(self._accion(Gtk.Button(child=icono_ui("touchpad")),
                                            self._entrar_touchpad))
        barra.set_center_widget(self._accion(Gtk.Button(child=icono_ui("home")),
                                             self._ir_inicio))
        # el Control Center llega en la fase 3; mientras tanto abre la configuración
        barra.set_end_widget(self._accion(Gtk.Button(child=icono_ui("control-center")),
                                          self._abrir_config))
        return barra

    # ----- touchpad temporal -------------------------------------------------

    def _touchpad(self):
        capas = Gtk.Overlay()
        capas.set_child(self._crear_fondo(difuminado=True))
        self.estela_w = Estela()
        capas.add_overlay(self.estela_w)
        pista = Gtk.Label(label="Toca con cuatro dedos para volver",
                          css_classes=["pista"], valign=Gtk.Align.END,
                          halign=Gtk.Align.CENTER, can_target=False)
        capas.add_overlay(pista)
        return capas

    def _crear_fondo(self, difuminado):
        fondo = Gtk.Stack(can_target=False)
        fondo.add_named(Gtk.Box(css_classes=["fondo-predeterminado"]), "default")
        fondo.add_named(Gtk.Box(css_classes=["fondo-color"]), "color")
        imagen = Gtk.Picture(content_fit=Gtk.ContentFit.COVER,
                             css_classes=["fondo-imagen", "difuminado"] if difuminado
                             else ["fondo-imagen"])
        fondo.add_named(imagen, "image")
        self.fondos.append((fondo, imagen))
        return fondo

    def _aplicar_fondo(self):
        c = self.conf
        try:
            blur = max(0, min(60, int(c["background_blur"])))
        except (TypeError, ValueError):
            blur = 12
        fondo = color(c["background_color"]).to_string()
        # la imagen difuminada se agranda un poco para que el blur no deje bordes claros
        css = (f".fondo-color, .fondo-imagen {{ background: {fondo}; }}\n"
               f".difuminado {{ filter: blur({blur}px); transform: scale(1.06); }}\n")
        self.css_fondo.load_from_data(css.encode())
        ruta = os.path.expanduser(str(c["background"]))
        modo = c["background_mode"]
        if modo == "image" and not os.path.isfile(ruta):
            modo = "default"
        if modo not in ("default", "color", "image"):
            modo = "default"
        for pila, imagen in self.fondos:
            if modo == "image":
                imagen.set_filename(ruta)
            else:
                imagen.set_paintable(None)
            pila.set_visible_child_name(modo)

    def _entrar_touchpad(self):
        debug("touchpad temporal")
        self._cerrar_hoja()
        self.vista.set_visible_child_name("touchpad")
        self.pad.tomar(False)
        self._programar_vuelta()

    def _volver_launcher(self):
        debug("vuelta al launcher")
        self._cancelar_vuelta()
        self.estela_w.limpiar()
        self.vista.set_visible_child_name("launcher")
        self.pad.tomar(True)

    def _en_touchpad(self):
        return (self.modo == "launcher" and self.ventana is not None
                and self.vista.get_visible_child_name() == "touchpad")

    def _programar_vuelta(self):
        self._cancelar_vuelta()
        try:
            s = float(self.conf["touchpad_return"])
        except (TypeError, ValueError):
            s = 4
        if s > 0:
            self.volver = GLib.timeout_add(int(s * 1000), self._fin_vuelta)

    def _fin_vuelta(self):
        self.volver = 0
        if self._en_touchpad():
            self._volver_launcher()
        return False

    def _cancelar_vuelta(self):
        if self.volver:
            GLib.source_remove(self.volver)
            self.volver = 0

    # llamadas desde Pad

    def al_apoyar(self):
        if self._en_touchpad():
            self._cancelar_vuelta()

    def al_soltar(self):
        if self._en_touchpad():
            self._programar_vuelta()

    def estela(self, puntos):
        if self._en_touchpad():
            self.estela_w.agregar(puntos)

    def cuatro_dedos(self):
        if self.modo != "launcher" or not self.ventana:
            return
        if self._en_touchpad():
            self._volver_launcher()
        else:
            self._entrar_touchpad()

    # ----- acciones ----------------------------------------------------------

    def _accion(self, widget, al_tocar, al_mantener=None):
        """Registra la acción del widget para el pad; con mouse los botones funcionan igual."""
        self.n_acciones += 1
        nombre = f"accion{self.n_acciones}"
        widget.set_name(nombre)
        self.acciones[nombre] = (al_tocar, al_mantener)
        if isinstance(widget, Gtk.Button):
            widget.set_focus_on_click(False)
            widget.connect("clicked", lambda _b: al_tocar())
        return widget

    def _vaciar(self, contenedor):
        """Quita los hijos y olvida sus acciones."""
        while (hijo := contenedor.get_first_child()):
            pendientes = [hijo]
            while pendientes:
                w = pendientes.pop()
                self.acciones.pop(w.get_name(), None)
                c = w.get_first_child()
                while c:
                    pendientes.append(c)
                    c = c.get_next_sibling()
            contenedor.remove(hijo)

    def accion_en(self, x, y):
        w = self.ventana.pick(x, y, Gtk.PickFlags.DEFAULT)
        while w is not None and w.get_name() not in self.acciones:
            w = w.get_parent()
        return w

    def activar(self, widget, largo=False):
        al_tocar, al_mantener = self.acciones[widget.get_name()]
        if largo:
            if al_mantener:
                al_mantener()
        else:
            al_tocar()

    def desplazar(self, x, y, dy):
        w = self.ventana.pick(x, y, Gtk.PickFlags.DEFAULT)
        while w is not None and not isinstance(w, Gtk.ScrolledWindow):
            w = w.get_parent()
        if w:
            aj = w.get_vadjustment()
            aj.set_value(aj.get_value() - dy)

    def _abrir(self, app):
        debug(f"abre {app.get_id()}")
        try:
            app.launch([], Gdk.Display.get_default().get_app_launch_context())
        except GLib.Error as e:
            log(f"no se pudo abrir {app.get_id()}: {e.message}")

    def _abrir_config(self):
        local = os.path.join(AQUI, "screenpad-config")
        cmd = local if os.access(local, os.X_OK) else "screenpad-config"
        try:
            Gio.Subprocess.new([cmd], Gio.SubprocessFlags.NONE)
        except GLib.Error as e:
            log(f"no se pudo abrir la configuración: {e.message}")

    def _ir(self, pagina):
        if self.paginas.get_visible_child_name() != pagina:
            self.paginas.set_visible_child_name(pagina)

    def _ir_inicio(self):
        self._cerrar_hoja()
        self.paginas.set_visible_child_name("inicio")
        if self.n_paginas:
            self._ver_pagina(0, animar=self.pagina != 0)

    # ----- configuración -----------------------------------------------------

    def _vigilar_config(self):
        self.monitor_config = Gio.File.new_for_path(CONFIG).monitor_file(
            Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.monitor_config.connect("changed", self._config_cambiada)

    def _config_cambiada(self, _m, _f, _otro, evento):
        if evento in (Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED,
                      Gio.FileMonitorEvent.RENAMED, Gio.FileMonitorEvent.MOVED_IN,
                      Gio.FileMonitorEvent.DELETED):
            debug("config recargada")
            self.conf = leer_config()
            if self.ventana:
                self._aplicar_fondo()

    # ----- screenpadd --------------------------------------------------------

    def _conectar_servicio(self):
        Gio.bus_watch_name(Gio.BusType.SESSION, BUS, Gio.BusNameWatcherFlags.NONE,
                           self._con_servicio, self._sin_servicio)

    def _con_servicio(self, bus, _nombre, _dueño):
        self.servicio = Gio.DBusProxy.new_sync(bus, Gio.DBusProxyFlags.NONE, None,
                                               BUS, RUTA, BUS, None)
        self.servicio.connect("g-signal", self._señal)
        modo = self.servicio.get_cached_property("Mode")
        self._aplicar_modo(modo.unpack() if modo else None)

    def _sin_servicio(self, *_):
        self.servicio = None
        self._aplicar_modo(None)

    def _señal(self, _proxy, _emisor, señal, params):
        if señal == "ModeChanged":
            self._aplicar_modo(params.unpack()[0])

    def _aplicar_modo(self, modo):
        debug(f"modo: {modo}")
        self.modo = modo
        self._cancelar_vuelta()
        if not self.ventana:
            self.pad.cerrar()
            return
        if modo == "launcher":
            self._ir_inicio()
            self._achicar(False)
            self.vista.set_visible_child_name("launcher")
            if self.pad.abrir():
                self.pad.tomar(True)
        else:
            self.pad.cerrar()
            self.estela_w.limpiar()
            self._achicar(True)


def main():
    app = Launcher()
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal_add(GLib.PRIORITY_DEFAULT, sig, lambda: app.quit() or False)
    app.run([a for a in sys.argv if a != "--debug"])
    app.pad.cerrar()


if __name__ == "__main__":
    main()
