def log(*a):
    print("screenpad-launcher:", *a, file=sys.stderr, flush=True)


def debug(*a):
    if DEBUG:
        log(*a)


def leer_config():
    conf = dict(CONFIG_PREDETERMINADA)
    try:
        with open(CONFIG, "rb") as f:
            conf.update(tomllib.load(f))
    except FileNotFoundError:
        pass
    except (tomllib.TOMLDecodeError, OSError) as e:
        log(f"config ignorada ({CONFIG}): {e}")
    return conf


def leer_inicio():
    """Ids del inicio en orden; siempre incluye ID_APPS."""
    ids = None
    try:
        with open(INICIO) as f:
            ids = json.load(f)
    except (FileNotFoundError, ValueError, OSError):
        pass
    if isinstance(ids, list):
        ids = [i for i in ids if isinstance(i, str)]
    else:
        instaladas = {a.get_id() for a in Gio.AppInfo.get_all()}
        ids = [i for i in INICIO_PREDETERMINADO if i in instaladas]
    return ids if ID_APPS in ids else ids + [ID_APPS]


def guardar_inicio(ids):
    os.makedirs(os.path.dirname(INICIO), exist_ok=True)
    tmp = INICIO + ".tmp"
    with open(tmp, "w") as f:
        json.dump(ids, f)
    os.replace(tmp, INICIO)


def buscar_salida(conf):
    """El monitor del ScreenPad: el de la config, el último de 'screenpad on' o el Toshiba."""
    nombre = conf["output"]
    if not nombre:
        try:
            with open(CONECTOR) as f:
                nombre = f.read().strip()
        except OSError:
            pass
    monitores = Gdk.Display.get_default().get_monitors()
    for i in range(monitores.get_n_items()):
        m = monitores.get_item(i)
        if nombre and m.get_connector() == nombre:
            return m
        if not nombre and "Toshiba" in (m.get_manufacturer() or ""):
            return m
    return None


def buscar_pad(nombre):
    for ruta in evdev.list_devices():
        try:
            d = evdev.InputDevice(ruta)
        except OSError:
            continue
        if d.name == nombre:
            return d
        d.close()
    return None


