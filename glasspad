#!/usr/bin/env python3
# glasspad - controla glasspadd desde la terminal (alias: gpad)
# kan0p - https://github.com/kan0p/asus-screenpad-linux - GPL-3.0-or-later
"""uso: glasspad status
       glasspad next
       glasspad mode launcher|monitor|dark|off
       glasspad brightness 1-255"""

import sys

import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

BUS = "io.github.kan0p.GlassPad"
RUTA = "/io/github/kan0p/GlassPad"


def main(args):
    if not args or args[0] in ("-h", "--help"):
        sys.exit(__doc__)
    try:
        p = Gio.DBusProxy.new_for_bus_sync(Gio.BusType.SESSION, Gio.DBusProxyFlags.NONE,
                                           None, BUS, RUTA, BUS, None)
        if p.get_name_owner() is None:
            sys.exit("glasspad: glasspadd no está corriendo")
        cmd = args[0]
        if cmd == "status":
            for prop in ("Mode", "Brightness", "Cycle"):
                v = p.get_cached_property(prop)
                print(f"{prop.lower()}: {v.unpack() if v else '?'}")
        elif cmd == "next":
            p.call_sync("NextMode", None, Gio.DBusCallFlags.NONE, 2000, None)
        elif cmd == "mode" and len(args) == 2:
            p.call_sync("SetMode", GLib.Variant("(s)", (args[1],)),
                        Gio.DBusCallFlags.NONE, 2000, None)
        elif cmd == "brightness" and len(args) == 2 and args[1].isdigit():
            p.call_sync("SetBrightness", GLib.Variant("(u)", (int(args[1]),)),
                        Gio.DBusCallFlags.NONE, 2000, None)
        else:
            sys.exit(__doc__)
    except GLib.Error as e:
        # "GDBus.Error:io.github.kan0p.GlassPad.Error: el launcher no está corriendo"
        mensaje = e.message.split(": ", 1)[-1] if e.message.startswith("GDBus.Error:") else e.message
        sys.exit(f"glasspad: {mensaje}")


if __name__ == "__main__":
    main(sys.argv[1:])
